#!/usr/bin/env bash
# The only path that may talk to the phone. Runs the installed copy of the
# wrapper, never the worktree file (ADR-024). The user installs a new copy with
# `bash tools/gate/apply.sh` after reviewing a wrapper change.
set -euo pipefail
installed="${XDG_DATA_HOME:-$HOME/.local/share}/pixel-phone/phone"
if [ ! -f "$installed" ]; then
  echo "failed: no installed wrapper at $installed; the user runs bash tools/gate/apply.sh" >&2
  exit 1
fi
root=$(git -C "$(dirname -- "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)
cd "$root"
exec python3 -I "$installed" "$@"
