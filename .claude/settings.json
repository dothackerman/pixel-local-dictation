{
  "permissions": {
    "deny": [
      "Bash(adb:*)",
      "Bash(fastboot:*)",
      "Bash(*platform-tools/adb*)",
      "Bash(*platform-tools/fastboot*)",
      "Bash(sudo:*)",
      "Edit(/.claude)",
      "Edit(/.claude/**)",
      "Edit(/.codex)",
      "Edit(/.codex/**)",
      "Edit(/.agents)",
      "Edit(/.agents/**)",
      "Edit(/.git)",
      "Edit(/.git/**)",
      "Edit(/.aws)",
      "Edit(/.aws/**)",
      "Edit(/tools/phone)",
      "Edit(/tools/git-hooks)",
      "Edit(/tools/git-hooks/**)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)"
    ],
    "allow": [
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "project_root=$(git rev-parse --show-toplevel) || exit 2; bash \"$project_root/.claude/hooks/phone-guard.sh\" || exit 2",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": true,
    "excludedCommands": [
    ],
    "filesystem": {
      "denyWrite": [
        "./.claude",
        "./.codex",
        "./.agents",
        "./.git",
        "./.aws",
        "./tools/phone",
        "./tools/git-hooks",
        "./AGENTS.md"
      ]
    }
  }
}
