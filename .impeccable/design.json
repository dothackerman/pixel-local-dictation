  "components": [
    {
      "name": "Microphone disk",
      "kind": "button",
      "refersTo": "microphone-disk",
      "description": "The same red-orange disk in every state; the mic glyph becomes Stop while recording; hairline ring at rest.",
      "html": "<div class=\"ds-stage\"><button class=\"ds-mic\" aria-label=\"Start recording\"><svg viewBox=\"0 -960 960 960\" width=\"24\" height=\"24\"><path fill=\"currentColor\" d=\"M480-400q-50 0-85-35t-35-85v-240q0-50 35-85t85-35q50 0 85 35t35 85v240q0 50-35 85t-85 35Zm-40 280v-123q-104-14-172-93t-68-184h80q0 83 58.5 141.5T480-320q83 0 141.5-58.5T680-520h80q0 105-68 184t-172 93v123h-80Z\"/></svg></button></div>",
      "css": ".ds-stage{display:grid;place-items:center;width:140px;height:140px;background:#E9DCC1}.ds-stage::before{content:'';grid-area:1/1;width:104px;height:104px;border-radius:50%;background:#F3E9D4;border:1px solid #6D6550}.ds-mic{grid-area:1/1;width:70px;height:70px;border-radius:50%;border:0;background:#A52E07;color:#fff;display:grid;place-items:center;cursor:pointer}.ds-mic:focus-visible{outline:2px solid #1C1A12;outline-offset:3px}.ds-mic:active{filter:brightness(1.15)}"
    },
    {
      "name": "Paused choice",
      "kind": "custom",
      "refersTo": "paused-continue",
      "description": "Three icon-only buttons at one height: Continue filled with a fixed selected ring, Stop outlined, Discard dashed in error and set 40dp apart.",
      "html": "<div class=\"ds-trio\"><button class=\"ds-cont\" aria-label=\"Continue recording\">&#9654;</button><button class=\"ds-stop\" aria-label=\"Stop and insert\">&#9632;</button><button class=\"ds-disc\" aria-label=\"Discard take\">&#128465;</button></div>",
      "css": ".ds-trio{display:flex;align-items:center;gap:8px;background:#E9DCC1;padding:16px}.ds-trio button{width:64px;height:56px;border-radius:0;font-size:20px;cursor:pointer;background:transparent}.ds-cont{background:#A52E07!important;color:#fff;border:0;box-shadow:0 0 0 2px #E9DCC1,0 0 0 4px #1C1A12}.ds-stop{border:2px solid #1C1A12;color:#1C1A12}.ds-disc{margin-left:32px;border:2px dashed #8A1145;color:#8A1145}.ds-trio button:focus-visible{outline:2px solid #1C1A12;outline-offset:4px}"
    },
    {
      "name": "Held text choice",
      "kind": "custom",
      "refersTo": "paused-continue",
      "description": "Unable to insert text: the status line says what to do and whether the text is saved and keeps its mark; the preview shows the held take text; the stage has two framed icon buttons instead of the disk: Copy text (filled, content_copy; outlined after a copy) and Discard text (dashed error). In narrow landscape the buttons stack in the stage. Back never copies: the first Back on uncopied text only warns, the second discards and leaves; after a copy Back leaves at once. A write after a rotation that could not be confirmed in the field says \"Could not confirm the insert. Check the field, or copy the text.\" with the Insertion uncertain mark and the same controls.",
      "html": "<div class=\"ds-trio\"><button class=\"ds-cont\" aria-label=\"Copy text\">&#10697;</button><button class=\"ds-disc\" aria-label=\"Discard text\">&#128465;</button></div>",
      "css": ".ds-trio{display:flex;align-items:center;gap:8px;background:#E9DCC1;padding:16px}.ds-trio button{width:64px;height:56px;border-radius:0;font-size:20px;cursor:pointer;background:transparent}.ds-cont{background:#A52E07!important;color:#fff;border:0;box-shadow:0 0 0 2px #E9DCC1,0 0 0 4px #1C1A12}.ds-stop{border:2px solid #1C1A12;color:#1C1A12}.ds-disc{margin-left:32px;border:2px dashed #8A1145;color:#8A1145}.ds-trio button:focus-visible{outline:2px solid #1C1A12;outline-offset:4px}"
    },
    {
      "name": "History row",
      "kind": "card",
      "refersTo": "history-row",
      "description": "The time leads, one mark slot under it, two-line preview, trailing trash; hairline below.",
      "html": "<div class=\"ds-row\"><div class=\"ds-time\">14:05<br><span class=\"ds-mark\">&#9998;&#824;</span></div><p>Reminder to return the ladder to the neighbours before Friday evening.</p><button aria-label=\"Delete transcript\">&#128465;</button></div>",
      "css": ".ds-row{display:grid;grid-template-columns:48px 1fr 48px;gap:12px;align-items:start;padding:12px 8px 12px 24px;background:#F3E9D4;border-bottom:1px solid #C7B999;font:400 16px/25px 'Public Sans',sans-serif;color:#1C1A12}.ds-time{font:800 15px/20px 'Big Shoulders Display',sans-serif;letter-spacing:.03em}.ds-row p{margin:0}.ds-row button{width:48px;height:48px;border:0;background:transparent;color:#4E4838;cursor:pointer}.ds-row:hover{background:#DDCEAF}"
    },
    {
      "name": "Toolbar",
      "kind": "nav",
      "refersTo": "toolbar",
      "description": "64dp, display-face title, closed by a 2dp ink rule.",
      "html": "<header class=\"ds-bar\"><span>&#8592;</span><h1>History</h1><span>&#8942;</span></header>",
      "css": ".ds-bar{display:flex;align-items:center;gap:16px;height:64px;padding:0 16px;background:#F3E9D4;border-bottom:2px solid #1C1A12;color:#1C1A12}.ds-bar h1{flex:1;margin:0;font:800 26px/30px 'Big Shoulders Display',sans-serif}"
    },
    {
      "name": "Square switch",
      "kind": "input",
      "refersTo": "icon-button",
      "description": "Rind-green track and white thumb at the end when on; outline thumb at the start when off.",
      "html": "<label class=\"ds-sw\"><input type=\"checkbox\" checked><span></span></label>",
      "css": ".ds-sw input{display:none}.ds-sw span{display:inline-block;width:52px;height:32px;background:#DDCEAF;border:2px solid #6D6550;box-sizing:border-box;position:relative}.ds-sw span::after{content:'';position:absolute;left:6px;top:6px;width:16px;height:16px;background:#6D6550}.ds-sw input:checked+span{background:#2E4A21;border-color:#2E4A21}.ds-sw input:checked+span::after{left:auto;right:4px;top:4px;width:20px;height:20px;background:#fff}"
    }
  ],
  "narrative": {
    "northStar": "Kraft card printed in two inks",
    "overview": "Red-orange and rind green on a warm card ground, Big Shoulders Display for names, times and counts, Public Sans for what the owner reads. One fixed light scheme for the recording panel and every screen; the light panel next to a dark keyboard is deliberate.\n\nCorners are square except the microphone disk and ring; 2dp rules close toolbars and the panel, 1dp hairlines separate rows. Every state has words: status text, tooltips on icon-only buttons and one sentence per History mark.",
    "keyCharacteristics": [
      "One fixed light theme, no dynamic colour",
      "Two inks: red-orange primary, rind-green secondary",
      "Condensed display face for titles, times and counts",
      "Square corners, 2dp rules, 1dp hairlines",
      "One mark per History row, one sentence per mark",
      "Undo after delete; Discard take final at once"
    ],
    "rules": [
      {
        "name": "The Display Rule",
        "body": "Names, times and counts in Big Shoulders Display; prose in Public Sans.",
        "section": "typography"
      },
      {
        "name": "The One Mark Rule",
        "body": "At most one mark per take: in progress, cut short, unable to insert, uncertain. Clean takes carry none.",
        "section": "colors"
      },
      {
        "name": "The One Disk Rule",
        "body": "The microphone disk is one colour in every state; the glyph and status say what it does.",
        "section": "colors"
      },
      {
        "name": "The Flat Card Rule",
        "body": "No shadows; rules and hairlines carry structure.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do resolve theme roles; hex only in values/colors.xml.",
      "Do give every state words: status, tooltips, one sentence per mark.",
      "Do keep 48dp targets (56dp on the panel) and check font scale 2 in both orientations.",
      "Do keep Undo after deletion; Discard take in the panel is final at once (owner, 2026-11-11)."
    ],
    "donts": [
      "Don't add DayNight resources, dynamic colour or a second theme.",
      "Don't round corners except the microphone disk and ring.",
      "Don't put more than one mark on a row, or transport glyphs in a mark slot.",
      "Don't promise accuracy gains for new dictionary terms."
    ]
  }
