<?xml version="1.0" encoding="utf-8"?>
<!-- Voice-only input method. No locale is declared on purpose: the recognizer
     decides the language per recording (R2). overridesImplicitlyEnabledSubtype makes
     Android count this subtype as enabled although it has no locale (SubtypeUtils
     .getImplicitlyApplicableSubtypesImpl); without it FUTO's shortcut lookup finds nothing.
     configChanges: lets the service rebuild its own panel for a rotation or resize
     (onConfigurationChanged) instead of having the views reset. It does NOT stop Android
     restarting input: on the Pixel the platform restarts input inside every rotation's
     configuration change anyway, also with resourcesUnused declared (ADR-010, #56). The
     rotation hold absorbs that restart; see EditorEventPolicy. -->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
    android:isDefault="false"
    android:settingsActivity="ch.og.dictation.SettingsActivity"
    android:supportsSwitchingToNextInputMethod="true">
    <subtype
        android:label="@string/ime_label"
        android:imeSubtypeMode="voice"
        android:isAuxiliary="true"
        android:overridesImplicitlyEnabledSubtype="true" />
</input-method>
