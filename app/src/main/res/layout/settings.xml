<?xml version="1.0" encoding="utf-8"?>
<!-- Settings (#36 Crate B2): the shared toolbar structure (outside the scroll, 64dp, 2dp rule),
     then navigation rows with their counts and the benchmark section. Text sits on the 24dp inset. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settings_toolbar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:title="@string/settings_label" />
    <View android:layout_width="match_parent" android:layout_height="2dp" android:background="?attr/colorOnSurface" />
    <ScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <!-- Navigation rows of equal weight: one tap target each, title in the body role, count
                 trailing in the display face, then a chevron. -->
            <LinearLayout
                android:id="@+id/open_dictionary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="64dp" android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="24dp" android:paddingEnd="12dp" android:paddingVertical="12dp"
                android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/dictionary_title" android:textAppearance="?attr/textAppearanceBodyLarge" android:textColor="?attr/colorOnSurface" />
                <TextView android:id="@+id/settings_dictionary_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="16dp" android:visibility="gone"
                    android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/colorOnSurfaceVariant" />
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="8dp"
                    android:src="@drawable/ic_chevron_right" android:importantForAccessibility="no" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" />
            <LinearLayout
                android:id="@+id/open_history" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="64dp" android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="24dp" android:paddingEnd="12dp" android:paddingVertical="12dp"
                android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/history_title" android:textAppearance="?attr/textAppearanceBodyLarge" android:textColor="?attr/colorOnSurface" />
                <!-- Saved-transcript count only; History warnings live on the History page. -->
                <TextView android:id="@+id/settings_history_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="16dp" android:visibility="gone"
                    android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/colorOnSurfaceVariant" />
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="8dp"
                    android:src="@drawable/ic_chevron_right" android:importantForAccessibility="no" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" />
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:paddingHorizontal="24dp" android:paddingBottom="8dp"
                android:accessibilityHeading="true"
                android:text="@string/benchmark_section" android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/colorOnSurface" />
            <View android:layout_width="match_parent" android:layout_height="2dp" android:background="?attr/colorOnSurface" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/benchmark_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:paddingStart="24dp"
                android:paddingEnd="16dp"
                android:textColor="?attr/colorOnSurface"
                android:text="@string/benchmark_switch" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="24dp"
                android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant"
                android:text="@string/benchmark_explanation" />
            <TextView
                android:id="@+id/benchmark_stored"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingHorizontal="24dp"
                android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/colorOnSurfaceVariant" />
            <!-- Destructive and rare: a quiet underlined error-colour text action under the data it deletes. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/benchmark_delete"
                style="@style/Widget.Dictation.Button.Text.Destructive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:minHeight="48dp"
                app:icon="@drawable/ic_delete"
                android:text="@string/benchmark_delete" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
