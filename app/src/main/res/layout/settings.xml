<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="24dp">
    <Switch
        android:id="@+id/benchmark_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:textSize="18sp"
        android:text="@string/benchmark_switch" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/benchmark_explanation" />
    <TextView
        android:id="@+id/benchmark_stored"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="24dp" />
    <Button
        android:id="@+id/benchmark_delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/benchmark_delete" />
</LinearLayout>
