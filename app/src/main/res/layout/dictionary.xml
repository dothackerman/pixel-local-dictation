<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/dictionary_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/colorSurface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/dictionary_toolbar"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp"
            app:title="@string/dictionary_title" app:navigationIcon="@drawable/ic_arrow_back" app:navigationContentDescription="@string/dictionary_back" />
        <View android:layout_width="match_parent" android:layout_height="2dp" android:background="?attr/colorOnSurface" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp" android:layout_marginTop="12dp" android:layout_marginBottom="16dp"
            android:text="@string/dictionary_explanation" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/dictionary_search_layout" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp" android:layout_marginBottom="16dp" app:hintEnabled="false"
            app:boxCornerRadiusTopStart="0dp" app:boxCornerRadiusTopEnd="0dp" app:boxCornerRadiusBottomStart="0dp" app:boxCornerRadiusBottomEnd="0dp"
            app:boxBackgroundColor="?attr/colorSurfaceContainerHigh"
            style="@style/Widget.Material3.TextInputLayout.FilledBox" app:endIconMode="clear_text"
            app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp" app:startIconDrawable="@drawable/ic_search">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/dictionary_search" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="16dp" android:paddingBottom="16dp"
                android:hint="@string/dictionary_search" android:textColorHint="?attr/colorOnSurfaceVariant" android:inputType="text" android:imeOptions="actionSearch|flagNoPersonalizedLearning|flagNoExtractUi" android:maxLines="1" android:singleLine="true" android:importantForAutofill="no" />
        </com.google.android.material.textfield.TextInputLayout>
        <!-- Count and languages over an ink rule; hidden with the search on an empty dictionary,
             where the state line alone speaks (#36 critique). -->
        <LinearLayout android:id="@+id/dictionary_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="24dp" android:paddingBottom="8dp" android:gravity="center_vertical">
            <TextView android:id="@+id/dictionary_count" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dictionary_languages" android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
        <View android:id="@+id/dictionary_summary_rule" android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOnSurface" />
        <TextView android:id="@+id/dictionary_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp"
            android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurface" android:accessibilityLiveRegion="polite" android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/dictionary_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:paddingBottom="104dp" android:clipToPadding="false" />
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton android:id="@+id/dictionary_add"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="24dp"
        android:text="@string/dictionary_add" app:icon="@drawable/ic_add" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
