<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/dictionary_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/colorSurface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/dictionary_toolbar"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp"
            app:title="@string/dictionary_title" app:navigationIcon="@drawable/ic_dictionary_back" app:navigationIconTint="?attr/colorOnSurface" app:navigationContentDescription="@string/dictionary_back" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp" android:layout_marginBottom="20dp"
            android:text="@string/dictionary_explanation" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp" android:layout_marginBottom="16dp" app:hintEnabled="false"
            app:boxCornerRadiusTopStart="28dp" app:boxCornerRadiusTopEnd="28dp" app:boxCornerRadiusBottomStart="28dp" app:boxCornerRadiusBottomEnd="28dp"
            style="@style/Widget.Material3.TextInputLayout.FilledBox" app:endIconMode="clear_text"
            app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp" app:startIconDrawable="@drawable/ic_dictionary_search">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/dictionary_search" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/dictionary_search" android:inputType="text" android:imeOptions="actionSearch|flagNoPersonalizedLearning" android:maxLines="1" android:singleLine="true" android:importantForAutofill="no" />
        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="26dp" android:paddingBottom="8dp" android:gravity="center_vertical">
            <TextView android:id="@+id/dictionary_count" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceLabelMedium" android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dictionary_languages" android:textAppearance="?attr/textAppearanceLabelMedium" android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
        <TextView android:id="@+id/dictionary_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp"
            android:textAppearance="?attr/textAppearanceBodyMedium" android:accessibilityLiveRegion="polite" android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/dictionary_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:paddingHorizontal="16dp" android:paddingBottom="104dp" android:clipToPadding="false" />
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton android:id="@+id/dictionary_add"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="24dp"
        android:text="@string/dictionary_add" app:icon="@drawable/ic_dictionary_add" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
