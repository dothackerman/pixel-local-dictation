<?xml version="1.0" encoding="utf-8"?>
<!-- The panel's status block, shared by both orientations: Back, status and its marker slot, the
     Undo timer rule, the private-field line and the preview (newest of three lines last). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/back_to_keyboard" />
        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingVertical="4dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            android:breakStrategy="high_quality"
            android:hyphenationFrequency="normal"
            android:lineBreakWordStyle="phrase"
            android:accessibilityLiveRegion="polite"
            android:text="@string/status_opening" />
        <!-- One marker, only when nothing else on the panel shows the state (Unable to insert text).
             Its words are the status text, so the glyph itself is not announced. -->
        <ImageView
            android:id="@+id/status_marker"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </LinearLayout>
    <TextView
        android:id="@+id/retention_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:drawableStart="@drawable/ic_lock"
        tools:ignore="UseCompatTextViewDrawableXml"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />
    <!-- The preview's place; the Undo timer rule sits at its top while the preview is hidden, so
         the panel keeps its height. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp">
        <TextView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="12dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:minLines="3"
            android:maxLines="3"
            android:ellipsize="start"
            android:gravity="bottom"
            android:breakStrategy="high_quality"
            android:hyphenationFrequency="normal" />
        <!-- Take discarded: what is left of the Undo window, as a 2dp rule (same model as History delete). -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/undo_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:max="1000"
            android:importantForAccessibility="no"
            android:visibility="gone"
            app:showAnimationBehavior="none"
            app:hideAnimationBehavior="none"
            app:trackThickness="2dp"
            app:trackCornerRadius="0dp"
            app:indicatorTrackGapSize="0dp"
            app:trackStopIndicatorSize="0dp"
            app:indicatorColor="?attr/colorOnSurface"
            app:trackColor="?attr/colorOutlineVariant" />
    </FrameLayout>
</merge>
