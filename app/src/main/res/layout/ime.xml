<?xml version="1.0" encoding="utf-8"?>
<!-- Recording panel, portrait (#36 Crate B2). Inflated from Theme.Dictation; colours are theme
     roles only. A 2dp rule closes the panel against the host app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurfaceContainer">
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="?attr/colorOutline" />
    <TextView
        android:id="@+id/benchmark_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorErrorContainer"
        android:textColor="?attr/colorOnErrorContainer"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:padding="4dp"
        android:gravity="center"
        android:text="@string/benchmark_banner"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">
        <include layout="@layout/panel_status" />
        <FrameLayout
            android:id="@+id/stage"
            android:layout_width="match_parent"
            android:layout_height="200dp">
            <include layout="@layout/panel_stage" />
            <!-- The paused choice takes the stage's place; the panel height does not change. -->
            <include
                layout="@layout/panel_choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
