<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView
        android:id="@+id/benchmark_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#B00020"
        android:textColor="#FFFFFF"
        android:padding="4dp"
        android:gravity="center"
        android:text="@string/benchmark_banner"
        android:visibility="gone" />
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:text="@string/status_idle" />
    <TextView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="3"
        android:maxLines="3"
        android:ellipsize="start"
        android:gravity="bottom"
        android:textSize="14sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/record" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/record" />
        <Button android:id="@+id/stop" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/stop" android:enabled="false" />
        <Button android:id="@+id/cancel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/cancel" />
        <Button android:id="@+id/back" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/back" />
    </LinearLayout>
</LinearLayout>
