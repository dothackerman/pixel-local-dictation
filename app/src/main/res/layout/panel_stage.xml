<?xml version="1.0" encoding="utf-8"?>
<!-- The stage's contents in both orientations: the ring, the Preparing text arc and the microphone
     disk (one colour in every state; its glyph is the mic or the Stop square). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <ch.og.dictation.RecordingRingView
        android:id="@+id/recording_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />
    <ch.og.dictation.PreparingArcView
        android:id="@+id/processing"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:visibility="gone" />
    <ImageButton
        android:id="@+id/microphone"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_gravity="center"
        android:background="@drawable/mic_disk"
        android:src="@drawable/ic_mic"
        android:tint="?attr/colorOnPrimary"
        tools:ignore="UseAppTint"
        android:scaleType="centerInside"
        android:padding="23dp"
        android:contentDescription="@string/stop_recording" />
</merge>
