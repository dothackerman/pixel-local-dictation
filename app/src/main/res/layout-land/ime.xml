<?xml version="1.0" encoding="utf-8"?>
<!-- Narrow landscape window (under 600dp; the phone uses layout-w600dp-land/ime.xml): the same
     views, ids and rules as layout/ime.xml, side by side so the
     editor stays visible above. Status column on the start side, the stage under the right thumb;
     under 600dp the stage is square (panel_stage_width_land). The paused choice and Undo take the
     preview's place in the column; the stage is then empty (no microphone to tap by mistake). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurfaceContainer">
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="?attr/colorOutline" />
    <TextView
        android:id="@+id/benchmark_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorErrorContainer"
        android:textColor="?attr/colorOnErrorContainer"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:padding="4dp"
        android:gravity="center"
        android:text="@string/benchmark_banner"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <include layout="@layout/panel_status" />
            <include
                layout="@layout/panel_choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="56dp"
                android:layout_marginBottom="8dp" />
            <include
                layout="@layout/panel_undo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="56dp"
                android:layout_marginBottom="8dp" />
        </LinearLayout>
        <FrameLayout
            android:id="@+id/stage"
            android:layout_width="@dimen/panel_stage_width_land"
            android:layout_height="148dp"
            android:layout_marginStart="12dp">
            <include layout="@layout/panel_stage" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
