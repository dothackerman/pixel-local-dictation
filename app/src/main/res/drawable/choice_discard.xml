<?xml version="1.0" encoding="utf-8"?>
<!-- Discard take: the only dashed button, in the error colour (error and red-orange are close in
     lightness, so the dash, the trash glyph and the gap tell it apart, not colour). 64×56dp drawn,
     6dp inside the 76×68dp target. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/colorErrorContainer">
    <item android:top="6dp" android:bottom="6dp" android:left="6dp" android:right="6dp">
        <shape android:shape="rectangle"><stroke android:width="2dp" android:color="?attr/colorError"
            android:dashWidth="4dp" android:dashGap="3dp" /></shape></item>
    <item android:id="@android:id/mask" android:top="6dp" android:bottom="6dp" android:left="6dp" android:right="6dp"><shape android:shape="rectangle"><solid android:color="@android:color/white" /></shape></item>
</ripple>
