<?xml version="1.0" encoding="utf-8"?>
<!-- The mark the detail line named, in "What the marks mean": the panel-ground fill alone is too
     close to the sheet's surface, so a 4dp ink bar at the start carries it (#36 critique). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="?attr/colorSurfaceContainer" /></shape></item>
    <item android:width="4dp" android:gravity="start|fill_vertical"><shape android:shape="rectangle"><solid android:color="?attr/colorOnSurface" /></shape></item>
</layer-list>
