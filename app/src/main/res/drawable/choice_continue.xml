    <item><shape android:shape="rectangle"><stroke android:width="3dp" android:color="?attr/colorOnSurface" /></shape></item>
    <item android:top="6dp" android:bottom="6dp" android:left="6dp" android:right="6dp">
        <shape android:shape="rectangle"><solid android:color="?attr/colorPrimary" /></shape></item>
</ripple>
