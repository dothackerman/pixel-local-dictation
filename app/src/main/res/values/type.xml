<?xml version="1.0" encoding="utf-8"?>
<!-- Crate B2 type roles (#36). Big Shoulders Display 800: titles, status, headers, times and
     every count. Public Sans 400: body text. Scalable sp throughout. -->
<resources>
    <style name="TextAppearance.Dictation.Display" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/big_shoulders_display</item>
        <item name="android:fontFamily">@font/big_shoulders_display</item>
        <item name="android:textFontWeight">800</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <!-- Toolbar title, sheet title. -->
    <style name="TextAppearance.Dictation.TitleLarge" parent="TextAppearance.Dictation.Display">
        <item name="android:textSize">26sp</item>
        <item name="lineHeight">30sp</item>
    </style>
    <!-- Panel status. -->
    <style name="TextAppearance.Dictation.TitleMedium" parent="TextAppearance.Dictation.Display">
        <item name="android:textSize">18sp</item>
        <item name="lineHeight">22sp</item>
    </style>
    <!-- Day headers, times, detail meta, every count: tabular figures. -->
    <style name="TextAppearance.Dictation.TitleSmall" parent="TextAppearance.Dictation.Display">
        <item name="android:textSize">15sp</item>
        <item name="lineHeight">20sp</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <!-- Undo, text buttons, Snackbar action. -->
    <style name="TextAppearance.Dictation.LabelLarge" parent="TextAppearance.Dictation.Display">
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">20sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <!-- Panel helper line (private field), small labels. -->
    <style name="TextAppearance.Dictation.LabelMedium" parent="TextAppearance.Dictation.Display">
        <item name="android:textFontWeight">700</item>
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">18sp</item>
    </style>
    <style name="TextAppearance.Dictation.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/public_sans</item>
        <item name="android:fontFamily">@font/public_sans</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">25sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Dictation.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/public_sans</item>
        <item name="android:fontFamily">@font/public_sans</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
</resources>
