<?xml version="1.0" encoding="utf-8"?>
<!-- Benchmark build only (merged on top of the main manifest): LabTest holds a partial wake lock
     so that overnight phone runs with the screen off measure a running CPU. The release build
     does not get this permission. Still no INTERNET (R3). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application>
        <!-- Test-owned editor; no launcher/export in either APK. Release excludes it. -->
        <activity
            android:name=".EditorProbeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize|stateAlwaysVisible"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />
        <activity android:name=".DictionaryLargeTextPreviewActivity" android:exported="false"
            android:excludeFromRecents="true" android:theme="@style/Theme.Dictation.Settings"
            android:windowSoftInputMode="adjustResize" />
        <!-- Optional vendor drivers for the synthetic accelerator access probe. -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-pixel.so" android:required="false" />
        <uses-native-library android:name="libedgetpu_litert.so" android:required="false" />
        <uses-native-library android:name="libedgetpu_util.so" android:required="false" />
    </application>
</manifest>
