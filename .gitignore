# personal recordings, transcripts, benchmark exports (requirement R3/privacy)
corpus/
*.wav
*.flac
*.m4a
*.ogg
*.opus
# signing material
*.jks
*.keystore
# android build output
build/
.gradle/
local.properties
.idea/
*.iml
.kotlin/
# pinned third-party binaries, see assets.lock
models/
app/libs/
app/src/main/assets/
__pycache__/
.claude/worktrees/
# Impeccable: track skills, shared config and design docs; keep engines/local state out.
**/skills/impeccable/scripts/bin/
**/skills/impeccable/scripts/config.json
