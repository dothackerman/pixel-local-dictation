#!/usr/bin/env bash
# The only path that may talk to the phone. Runs the installed copy of the
# wrapper, never the worktree file (ADR-024). The user installs a new copy with
# `bash tools/gate/apply.sh` after reviewing a wrapper change.
set -euo pipefail
installed="${XDG_DATA_HOME:-$HOME/.local/share}/pixel-phone/phone"
if [ ! -f "$installed" ]; then
  echo "failed: no installed wrapper at $installed; the user runs bash tools/gate/apply.sh" >&2
  exit 1
fi
# The wrapper's lock and state are this repository's main checkout's corpus/lab, found from this file's
# own path, never from the caller's directory or GIT_* variables. It runs in the caller's directory, so
# relative paths resolve there; any checkout or worktree may call.
for variable in $(compgen -e); do
  case "$variable" in GIT_*) unset "$variable" ;; esac
done
common=$(git -C "$(dirname -- "${BASH_SOURCE[0]}")" rev-parse --path-format=absolute --git-common-dir)
exec python3 -I "$installed" --home "$(dirname -- "$common")" "$@"
