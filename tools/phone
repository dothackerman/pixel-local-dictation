        self.private('[ ! -e ' + marker + ' ] && [ ! -L ' + marker + ' ] && mkdir ' + self.paths['stage'] +
                     ' && { toybox timeout -s KILL 240 cp -r ' + temporary + '/. ' +
                     self.paths['stage'] + '/; result=$?; printf \'%s\\n\' "$result" > ' +
                     marker + '; exit "$result"; }', timeout=300)
