def flag(args, word):
    """(whether `word` is among the arguments, the arguments without it)."""
    return word in args, [arg for arg in args if arg != word]


def dispatch(argv, phone):
    verb, args = (argv[0] if argv else 'help'), argv[1:]
    if verb in ('help', '-h', '--help'):
        return {'usage': USAGE}
    simple = {'status': phone.status, 'device': phone.device_info, 'app': phone.app_info,
              'crash': phone.crash, 'stop': phone.stop, 'uninstall': phone.uninstall}
    if verb in simple:
        if args:
            raise Refused(verb + ' takes no arguments')
        return simple[verb]()
    if verb == 'check' and 1 <= len(args) <= 2:
        return phone.check(*args)
    if verb == 'install':
        promote, apks = flag(args, '--promote')
        if 1 <= len(apks) <= 2:
            return phone.install(*apks, promote=promote)
    if verb == 'push':
        model, folders = flag(args, '--model')
        if len(folders) == 1:
            return phone.push(folders[0], model=model)
    if verb == 'pull' and args:
        to = None
        if '--to' in args:
            i = args.index('--to')
            to, args = args[i + 1] if i + 1 < len(args) else None, args[:i] + args[i + 2:]
            if to is None:
                raise Refused('--to needs a directory')
        return phone.pull(args, to)
    if verb == 'run' and args:
        return phone.run(args[0], args[1:])
    if verb == 'measure' and args:
        return phone.measure(args[0], args[1:])
    if verb == 'logs' and len(args) in (0, 2):
        return phone.logs(args[1] if args else None)
    if verb in ('snapshot', 'restore'):
        switch, names = flag(args, '--switch')
        if len(names) == 1:
            return getattr(phone, verb)(names[0], switch=switch)
    if verb == 'forget' and len(args) == 1:
        return phone.forget(args[0])
    raise Refused('unknown command or arguments; see help')


def main(argv):
    caller = None
    if argv[:1] == ['--caller']:  # passed by the shim, first; a later one is just an unknown verb
        if len(argv) < 2:
            raise Refused('--caller needs a directory')
        caller, argv = argv[1], argv[2:]
    verb = argv[0] if argv else 'help'
    os.umask(0o077)
    device = Device(os.environ.get('ANDROID_HOME', Path.home() / 'Android/Sdk'))
    if verb in HOST_VERBS:
        result = dispatch(argv, Phone(device, None))
        print(result['usage'] if isinstance(result, dict) and set(result) == {'usage'}
              else json.dumps(result, indent=1, sort_keys=True))
        return 0
    common = subprocess.run(['git', 'rev-parse', '--path-format=absolute', '--git-common-dir'],
                            capture_output=True, text=True)
    if common.returncode:
        raise Failed('run from inside the checkout')
    state = main_checkout(caller, Path(common.stdout.strip()).parent) / 'corpus' / 'lab'
    phone = Phone(device, state)
    handle = phone.lock() if verb != 'status' else None
    try:
        result = dispatch(argv, phone)
    finally:
        if handle:
            handle.close()
    text = json.dumps(result, indent=1, sort_keys=True)
    state.mkdir(parents=True, exist_ok=True)
    (state / 'last.json').write_text(text)  # the shim must run alone; read this instead of piping
    print(text)
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as error:
        print('refused: ' + str(error), file=sys.stderr)
        sys.exit(3)
    except (Failed, OSError, subprocess.SubprocessError, tarfile.TarError, zipfile.BadZipFile, ValueError, KeyError) as error:
        print('failed: ' + str(error), file=sys.stderr)
        sys.exit(1)
