#!/usr/bin/env -S python3 -I
"""App-scoped phone access for ch.og.dictation (ADR-024).

Runs through `.claude/hooks/phone`, which executes the copy of this file the
user installed with `tools/gate/apply.sh`. Every device command is built from fixed templates with the
package constant; caller strings reach the device only as validated names.

Owner data (ADR-028): APKs are told apart by their build marker; `run`, `push` and `stop` work only in
an open Visit whose fingerprint equals its copy, and so does `measure`, which runs Lab runs on copies it
places in the lab folder; device verbs only from the main checkout. A Visit starts
by installing the lab build (release pulled, owner data copied at once) and ends by installing the
pulled release back; `phone help` holds the steps.

Exit 0: success, one JSON object on stdout.
Exit 3: `refused: <reason>` (policy).  Exit 1: `failed: <reason>` (device/transport).
"""
import hashlib
import io
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import uuid
import zipfile
from pathlib import Path

PKG = 'ch.og.dictation'
TEST = PKG + '.test'
RUNNER = TEST + '/androidx.test.runner.AndroidJUnitRunner'
MODEL = 'Pixel 10 Pro XL'
FUTO = ('org.futo.inputmethod.latin', 'org.futo.inputmethod.latin.playstore',
        'org.futo.voiceinput', 'org.futo.voiceinput.playstore')
PROPS = ('ro.product.model', 'ro.build.version.release', 'ro.build.version.sdk',
         'ro.build.version.security_patch', 'ro.build.id', 'ro.build.fingerprint', 'ro.soc.manufacturer', 'ro.soc.model',
         'ro.hardware', 'ro.hardware.vulkan', 'ro.hardware.egl', 'ro.opengles.version')
DRIVER_LIBS = re.compile(r'^(libOpenCL.*|libedgetpu.*|vulkan\..*|libGLES.*|libllvm-glnext.*)\.so$')
PERMISSIONS = {PKG: {'android.permission.RECORD_AUDIO', 'android.permission.WAKE_LOCK'}}
PERMISSIONS[TEST] = PERMISSIONS[PKG] | {'android.permission.REORDER_TASKS'}  # androidx test runner
NETWORK = {'android.permission.INTERNET', 'android.permission.ACCESS_NETWORK_STATE',
           'android.permission.QUERY_ALL_PACKAGES'}
NAME = re.compile(r'[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*')
HOST_VERBS = ('help', '-h', '--help', 'check')  # no device, no lock, no state: from any worktree
MARKER_GUARD = 1  # tools/gate/apply.sh refuses to install a wrapper without this line
MARKER_NAME = PKG + '.build'
MARKER = re.compile(r'layout=(owner|test);commit=[0-9a-f]{40};hash=[0-9a-f]{64}')
# Left out of the fingerprint and of copies: the lab folder (speech model, test output) and the test
# folders. tools/storage_guard.py fails when this differs from the test layout.
EXCLUDED = ('files/lab', 'files/test', 'no_backup/test', 'shared_prefs/test_history_notices.xml',
            'shared_prefs/test_settings.xml')
# Written by Android and androidx on their own (caches, cleared on update; the profile installer's note
# of the last update). Never owner data; left out of the fingerprint too.
SYSTEM_FILES = ('cache', 'code_cache', 'files/profileInstalled')
OWNER_SKIP = EXCLUDED + SYSTEM_FILES  # what a copy of owner data leaves out, like the fingerprint
LAB_FOLDER, TEST_FOLDERS = EXCLUDED[0], EXCLUDED[1:]
# Read-only: test output, owner recordings, the reserved timing-receipt folder, lab-build recordings.
PULL_ROOTS = (LAB_FOLDER, 'files/benchmark', 'files/timing-receipts', 'files/test')
# What the switch copy must hold before the one-time switch may go on (owner layout, ADR-028).
SWITCH_HOLDS = {'History': 'no_backup/history/', 'Dictionary': 'files/dictionary/',
                'History notices': 'shared_prefs/history_notices.xml', 'settings': 'shared_prefs/settings.xml'}
MICROPHONE = 'android.permission.RECORD_AUDIO'
LAB_RUN = PKG + '.labrun'  # Lab run classes live here; `run` refuses them, `measure` runs nothing else
# Owner data a Lab run may get a copy of, and where `measure` puts the copies: inside the lab folder,
# `files/X` at LAB_RUN_INPUTS/X. tools/device_classes.py fails when the Lab run harness reads another folder.
INPUT_ROOTS = ('files/benchmark', 'files/timing-receipts')
LAB_RUN_INPUTS = LAB_FOLDER + '/labrun-inputs'
# One line per Lab run in the instrumentation output, written by the harness (labrun/LabRun.kt).
LAB_RUN_COMPLETED, LAB_RUN_INCOMPLETE = 'LAB RUN completed', 'LAB RUN incomplete'
CLASSES = re.compile(r'[A-Za-z0-9_.]+(?:#[A-Za-z0-9_]+)?(?:,[A-Za-z0-9_.]+(?:#[A-Za-z0-9_]+)?)*')
VISIT_FIELDS = {'name', 'started', 'ended', 'release', 'copy', 'fingerprint', 'model', 'lab_builds'}


class Refused(Exception):
    """Policy refusal; retrying the same call will not help."""


class Failed(Exception):
    """Device or transport failure; the call may be retried."""


def name(value, root=None):
    if not NAME.fullmatch(value) or '..' in value.split('/'):
        raise Refused('unsupported name: ' + value[:60])
    if root is not None and not any(value == r or value.startswith(r + '/') for r in root):
        raise Refused('path outside ' + ' or '.join(root))
    return value


def sha(data):
    return hashlib.sha256(data).hexdigest()


def sha_file(path):
    digest = hashlib.sha256()
    with open(path, 'rb') as stream:
        for block in iter(lambda: stream.read(1 << 20), b''):
            digest.update(block)
    return digest.hexdigest()


def under(path, roots):
    return any(path == root or path.startswith(root + '/') for root in roots)


def walk(skip):
    """The `find` over app data that leaves `skip` out; the caller appends what to do with the rest."""
    return 'find . \\( %s \\) -prune -o' % ' -o '.join('-path ' + shlex.quote('./' + rel) for rel in skip)


def marker_layout(app, test=None):
    """The storage layout of an APK pair whose markers and debuggability agree; else refuse."""
    match = MARKER.fullmatch(app['marker'] or '')
    if not match:
        raise Refused('app APK has no build marker: a build from before ADR-028 reaches owner data'
                      if app['marker'] is None else 'app APK has a malformed build marker')
    layout = match.group(1)
    if app['debuggable'] != (layout == 'test'):
        raise Refused('app APK is %s but its marker names the %s layout'
                      % ('debuggable' if app['debuggable'] else 'not debuggable', layout))
    if test is not None:
        if not MARKER.fullmatch(test['marker'] or ''):
            raise Refused('test APK has no build marker')
        if test['marker'] != app['marker']:
            raise Refused('test APK comes from another build than the app APK')
    return layout


def main_checkout(caller, home):
    """`home` when the caller's directory lies in it outside any worktree; else refuse (ADR-028)."""
    if not caller:
        raise Refused('no caller directory: the phone is reached only through the shim, from the main checkout')
    path = Path(caller)
    if not path.is_absolute() or not path.is_dir():
        raise Refused('caller directory must be an existing absolute path')
    path = path.resolve()
    for folder in (path, *path.parents):
        if (folder / '.git').is_dir():
            if folder != Path(home).resolve():
                break
            return folder
        if (folder / '.git').exists():
            raise Refused('the phone is reached only from the main checkout, not from a worktree')
    raise Refused('the phone is reached only from the main checkout; the caller is outside it')


class Device:
    """The adb adapter. All argv are assembled here, nowhere else."""

    def __init__(self, sdk, runner=subprocess.run):
        self.sdk = Path(sdk)
        self.adb = self.sdk / 'platform-tools/adb'
        self.runner = runner
        self.serial = None

    def run(self, *args, timeout=60, binary=False, check=True, stdin=None):
        argv = [str(self.adb)] + (['-s', self.serial] if self.serial else []) + list(args)
        try:
            result = self.runner(argv, capture_output=True, text=not binary, timeout=timeout, input=stdin)
        except subprocess.TimeoutExpired:
            raise Failed('device command timed out after %ds' % timeout) from None
        except OSError as error:
            raise Failed('cannot start adb: ' + error.strerror) from None
        if check and result.returncode:
            err = result.stderr if isinstance(result.stderr, str) else result.stderr.decode(errors='replace')
            what = ' '.join(args[:2]).split('run-as')[0].strip()[:60]
            raise Failed(self.redact('%s: %s' % (what, err.strip()[-400:] or 'adb exited %d' % result.returncode)))
        return result.stdout

    def redact(self, text):
        text = text.replace(str(self.adb), 'adb')
        return text.replace(self.serial, '<serial>') if self.serial else text

    def connect(self):
        if self.serial:
            return
        rows = [line.split() for line in self.run('devices').splitlines()[1:] if line.strip()]
        if len(rows) != 1:
            raise Failed('need exactly one authorized phone; found %d' % len(rows))
        state = (rows[0][1:2] or ['unknown'])[0]
        if state != 'device':
            hint = ' (accept the USB debugging prompt on the phone)' if state == 'unauthorized' else ''
            raise Failed('phone state is %s, not device%s' % (state, hint))
        self.serial = rows[0][0]
        if self.shell('getprop ro.product.model').strip() != MODEL:
            self.serial = None
            raise Refused('connected device is not the permitted ' + MODEL)

    def shell(self, code, **kw):
        self.connect()
        return self.run('shell', code, **kw)

    def private(self, code, **kw):
        return self.shell('run-as %s sh -c %s' % (PKG, shlex.quote(code)), **kw)

    # --- read-only -------------------------------------------------------
    def props(self):
        return {p: self.shell('getprop ' + p).strip() for p in PROPS}

    def thermal(self):
        dump = self.shell('dumpsys thermalservice')
        status = re.search(r'^Thermal Status: *(\d)', dump, re.M)
        return int(status.group(1)) if status else None

    def driver_libs(self):
        names = self.shell('ls /vendor/lib64 /system/lib64 2>/dev/null').split()
        return sorted({n for n in names if DRIVER_LIBS.match(n)})

    def package(self, pkg):
        if pkg not in (PKG, TEST) + FUTO:
            raise Refused('package outside scope')
        # pm exits 1 for a package that is not installed; that is an answer, not a failure.
        paths = [l[8:] for l in self.shell('pm path ' + pkg, check=False).splitlines() if l.startswith('package:')]
        if not paths:
            return {'installed': False}
        dump = self.shell('dumpsys package ' + pkg)
        version_name = (re.search(r'\bversionName=(\S+)', dump) or [0, 'null'])[1]
        info = {'installed': True,
                'versionCode': int((re.search(r'\bversionCode=(\d+)', dump) or [0, 0])[1]),
                'versionName': None if version_name == 'null' else version_name}
        if pkg in FUTO:
            return info
        info['sha256'] = self.shell('sha256sum -- ' + shlex.quote(paths[0])).split()[0]
        info['apk_path'] = paths[0]
        uid = re.search(r'^\s*(?:userId|appId|uid)=(\d+)\s*$', dump, re.M)
        if not uid or int(uid.group(1)) < 10000:
            raise Failed('cannot determine the app uid from the package dump; refusing to guess')
        info['uid'] = int(uid.group(1))
        info['granted'] = sorted(set(re.findall(r'^\s+(android\.permission\.\S+): granted=true', dump, re.M)))
        first = re.search(r'^\s*firstInstallTime=(.+?)\s*$', dump, re.M)
        info['first_install'] = first.group(1) if first else None
        pid = self.shell('pidof ' + pkg, check=False).split()
        info['pid'] = int(pid[0]) if pid and pid[0].isdigit() else None
        return info

    def ime(self):
        """Booleans about our IME only; nothing about other keyboards."""
        dump = self.shell('dumpsys input_method')
        enabled = any(l.strip().startswith(PKG + '/') for l in self.shell('ime list -s').splitlines())
        selected = bool(re.search(r'^\s*(?:mCurMethodId|mSelectedMethodId)=' + re.escape(PKG) + '/', dump, re.M))
        bound = bool(re.search(r'^\s*(?:mCurId|mCurImeId)=' + re.escape(PKG) + '/', dump, re.M))
        shown = bool(re.search(r'^\s*mInputShown=true', dump, re.M))
        return {'enabled': enabled, 'selected': selected, 'bound': bound, 'input_shown': bound and shown}

    def inventory(self, rel):
        code = ('cd %s 2>/dev/null || exit 3; [ -z "$(find . -type l -print -quit)" ] || exit 4; '
                'find . -type f -exec sha256sum {} +') % shlex.quote(rel)
        self.connect()
        result = self.runner([str(self.adb), '-s', self.serial, 'shell', 'run-as %s sh -c %s' % (PKG, shlex.quote(code))],
                             capture_output=True, text=True, timeout=120)
        if result.returncode == 3:
            return None
        if result.returncode == 4:
            raise Refused('symlink inside app data; not touching it')
        if result.returncode:
            raise Failed(self.redact(result.stderr.strip()[-300:]))
        files = {}
        for line in result.stdout.splitlines():
            digest, _, path = line.partition('  ./')
            files[name(path)] = digest
        return files

    def fingerprint(self):
        """Names, sizes and digests of every app-data file outside EXCLUDED and SYSTEM_FILES, reduced
        on the phone to one digest and a file count; nothing else leaves it."""
        code = ('{ %(walk)s -type f -exec sha256sum {} + && %(walk)s -type f -exec stat -c "%%s %%n" {} + && '
                '%(walk)s ! -type f ! -type d -print; } | LC_ALL=C sort | sha256sum && %(walk)s -type f -print | wc -l'
                ) % {'walk': walk(OWNER_SKIP)}
        words = self.private(code, timeout=900).split()
        if len(words) != 3 or not re.fullmatch(r'[0-9a-f]{64}', words[0]) or not words[2].isdigit():
            raise Failed('unreadable fingerprint answer from the phone')
        return {'digest': words[0], 'files': int(words[2])}

    def logcat(self, uid, since=None, crash=False):
        if not crash and (type(uid) is not int or uid < 10000):
            raise Refused('logs need our app uid; system or unknown uids are out of scope')
        args = ['logcat', '-d', '-v', 'time']
        args += ['-b', 'crash'] if crash else ['--uid', str(uid)]
        if since:
            args += ['-T', since]
        self.connect()
        text = self.run(*args, timeout=120)
        if crash:
            lines = text.splitlines()
            keep = set()
            for i, line in enumerate(lines):
                if PKG in line:
                    keep.update(range(max(0, i - 2), min(len(lines), i + 40)))
            text = '\n'.join(lines[i] for i in sorted(keep)[-400:])
        return self.redact(text)

    def device_time(self):
        return self.shell("date '+%m-%d %H:%M:%S.000'").strip()

    # --- host-side APK inspection ---------------------------------------
    def tool(self, binary):
        found = sorted((self.sdk / 'build-tools').glob('*/' + binary))
        if not found:
            raise Failed('Android build tool missing: ' + binary)
        return str(found[-1])

    def apk_info(self, path):
        path = Path(path)
        if path.is_symlink() or not path.is_file() or path.suffix != '.apk':
            raise Refused('need an ordinary .apk file')
        badging = subprocess.run([self.tool('aapt2'), 'dump', 'badging', str(path)],
                                 capture_output=True, text=True, check=True).stdout
        header = re.search(r"^package: name='([^']+)' versionCode='(\d*)'", badging, re.M)
        if not header or header.group(1) not in (PKG, TEST):
            raise Refused('APK is not the dictation app or its test package')
        pkg = header.group(1)
        perms = set(re.findall(r"^uses-permission(?:-sdk-23)?: name='([^']+)'", badging, re.M))
        if perms & NETWORK:
            raise Refused('APK requests network or package-query permission: ' + ', '.join(sorted(perms & NETWORK)))
        if perms - PERMISSIONS[pkg]:
            raise Refused('APK permissions outside allowlist: ' + ', '.join(sorted(perms - PERMISSIONS[pkg])))
        tree = subprocess.run([self.tool('aapt2'), 'dump', 'xmltree', str(path), '--file', 'AndroidManifest.xml'],
                              capture_output=True, text=True, check=True).stdout
        if re.search(r'^\s*E: queries', tree, re.M):
            raise Refused('APK declares <queries>; package enumeration is out of scope')
        target = re.findall(r'targetPackage[^=]*="([^"]+)"', tree)
        if pkg == TEST and target != [PKG]:
            raise Refused('test APK must instrument only ' + PKG)
        signing = subprocess.run([self.tool('apksigner'), 'verify', '--print-certs', str(path)],
                                 capture_output=True, text=True, check=True).stdout
        signers = set(re.findall(r'certificate SHA-256 digest: ([0-9a-f]{64})', signing))
        if len(signers) != 1:
            raise Refused('need exactly one APK signer')
        marker = re.search(r':name\(0x01010003\)="%s"[^\n]*\n\s*A: [^\n]*:value\(0x01010024\)="([^"]*)"'
                           % re.escape(MARKER_NAME), tree)
        return {'package': pkg, 'versionCode': int(header.group(2) or 0), 'sha256': sha_file(path),
                'signer': signers.pop(), 'permissions': sorted(perms),
                'debuggable': bool(re.search(r'^application-debuggable\b', badging, re.M)),
                'marker': marker.group(1) if marker else None}

    # --- mutations --------------------------------------------------------
    def install(self, path, downgrade=False):
        """`downgrade` only for the retained unmarked build of the switch; Android allows it on a debuggable app."""
        self.connect()
        self.run('install', '-r', *(['-d'] if downgrade else []), str(path), timeout=600)

    def uninstall(self, pkg):
        if pkg not in (PKG, TEST):
            raise Refused('package outside scope')
        self.connect()
        self.run('uninstall', pkg, timeout=120)

    def stop(self):
        self.shell('am force-stop ' + PKG)

    def push(self, directory, changed, removed):
        """Into the lab folder only: send the `changed` files of the host directory, delete `removed`."""
        directory = validate_directory(directory)
        quoted_rel = shlex.quote(LAB_FOLDER)
        if removed:
            self.private('cd %s && rm -f -- %s' % (quoted_rel, ' '.join(shlex.quote(name(r)) for r in sorted(removed))),
                         timeout=120)
        if not changed:
            return
        tmp = '/data/local/tmp/dictation-' + uuid.uuid4().hex
        self.shell('mkdir ' + tmp)
        try:
            with tempfile.TemporaryDirectory() as staging:
                for item in sorted(changed):  # same layout, only the files that differ
                    target = Path(staging) / item
                    target.parent.mkdir(parents=True, exist_ok=True)
                    try:
                        os.link(directory / item, target)
                    except OSError:
                        shutil.copyfile(directory / item, target)
                self.run('push', staging + '/.', tmp, timeout=900)
            self.private('mkdir -p %s && cp -r %s/. %s/' % (quoted_rel, tmp, quoted_rel), timeout=600)
        finally:
            self.shell('rm -rf -- ' + tmp)

    def tar(self, *rels):
        existing = [r for r in rels if self.private('[ -e %s ] && echo y' % shlex.quote(r), check=False).strip() == 'y']
        if not existing:
            return b''
        self.connect()
        return self.run('exec-out', 'run-as', PKG, 'tar', 'c', *existing, timeout=900, binary=True)

    def copy(self, skip):
        """A tar of every app-data file outside `skip`: the walk of the fingerprint names the files, so a
        copy and a fingerprint with the same `skip` cover the same files. The list sits in `cache/`, which
        every copy leaves out."""
        if not under('cache', skip):
            raise Refused('a copy leaves the cache out')
        names = 'cache/.dictation-copy-list'
        code = ('mkdir -p cache && %s -type f -print > %s && { [ ! -s %s ] || tar c -T %s; }; '
                'status=$?; rm -f %s; exit $status') % (walk(skip), names, names, names, names)
        self.connect()
        return self.run('exec-out', 'run-as %s sh -c %s' % (PKG, shlex.quote(code)), timeout=1800, binary=True)

    def pull_apk(self, remote, local):
        self.connect()
        if not re.fullmatch(r'/data/app/[A-Za-z0-9_./=~+-]+\.apk', remote):
            raise Refused('unexpected installed APK path')
        Path(local).write_bytes(self.run('exec-out', 'cat', remote, timeout=600, binary=True))

    def replace(self, archive, skip):
        """Delete every app-data file outside `skip`, then extract a host-validated tar: what is in
        `skip` (the lab folder with the speech model, the test folders) is never touched.

        The archive is uploaded before anything is deleted: exec-out does not pass stdin EOF,
        so streaming into `tar x` hung after the wipe (2026-10-21)."""
        delete = walk(skip) + ' ! -type d -exec rm -f -- {} +'
        if not archive:
            self.private(delete, timeout=900)
            return
        remote = '/data/local/tmp/dictation-' + uuid.uuid4().hex + '.tar'
        with tempfile.NamedTemporaryFile(suffix='.tar') as local:
            local.write(archive)
            local.flush()
            os.chmod(local.name, 0o644)  # adb push keeps the mode; run-as must read it
            self.connect()
            self.run('push', local.name, remote, timeout=900)
        try:
            self.private('%s && tar xf %s' % (delete, remote), timeout=900)
        finally:
            self.shell('rm -f -- ' + remote)

    def empty_test_folders(self):
        self.private('rm -rf -- ' + ' '.join(shlex.quote(rel) for rel in TEST_FOLDERS), timeout=300)

    def place_inputs(self, sources):
        """Copies for one Lab run, made on the phone inside app data: each `files/X` of `sources` lands at
        LAB_RUN_INPUTS/X. What an earlier measure left there goes first. Returns the number of files copied."""
        quoted = shlex.quote(LAB_RUN_INPUTS)
        checks = ' '.join('[ -e %(s)s ] || echo missing %(s)s; [ -z "$(find %(s)s -type l -print -quit 2>/dev/null)" ] '
                          '|| echo link %(s)s;' % {'s': shlex.quote(name(source, INPUT_ROOTS))} for source in sources)
        found = self.private(checks, timeout=300).strip() if sources else ''
        if found:
            raise Refused('no such file or folder on the phone, or a symlink inside it: ' + found.replace('\n', ', ')[:300])
        steps = ['rm -rf -- ' + quoted, 'mkdir -p ' + quoted]
        for source in sources:
            target = LAB_RUN_INPUTS + source[len('files'):]
            steps += ['mkdir -p ' + shlex.quote(target.rsplit('/', 1)[0]),
                      'cp -R %s %s' % (shlex.quote(source), shlex.quote(target))]
        count = self.private(' && '.join(steps + ['find %s -type f | wc -l' % quoted]), timeout=900).strip()
        if not count.isdigit():
            raise Failed('unreadable answer from the phone after copying the Lab run inputs')
        return int(count)

    def remove_inputs(self):
        self.private('rm -rf -- ' + shlex.quote(LAB_RUN_INPUTS), timeout=300)

    def instrument(self, classes, extras, timeout):
        args = ' '.join('-e %s %s' % (shlex.quote(k), shlex.quote(v)) for k, v in extras)
        return self.shell('am instrument -w -r -e class %s %s %s' % (shlex.quote(classes), args, RUNNER), timeout=timeout)


def validate_directory(directory):
    """Only regular files and directories with safe names may leave the host."""
    directory = Path(directory)
    if not directory.is_dir():
        raise Refused('push needs a directory')
    for p in [directory, *directory.rglob('*')]:
        if p.is_symlink() or not (p.is_dir() or p.is_file()):
            raise Refused('only regular files and directories can be pushed')
        if p != directory:
            name(p.relative_to(directory).as_posix())
    return directory


def members(payload, inside=None, outside=()):
    """(path, member, archive) of every regular file of a tar from the phone or from our own state. Refuses
    anything but regular files and folders, `..`, absolute names, a path outside `inside` or under `outside`."""
    if not payload:
        return
    with tarfile.open(fileobj=io.BytesIO(payload)) as archive:
        for member in archive:
            path = member.name[2:] if member.name.startswith('./') else member.name
            parts = Path(path).parts
            if member.isdir() and path in ('.', ''):
                continue
            if (not parts or '..' in parts or path.startswith('/') or under(path, outside)
                    or (inside is not None and not under(path, inside))):
                raise Refused('archive member outside its place: ' + member.name[:80])
            if not (member.isfile() or member.isdir()):
                raise Refused('archive member is not a regular file: ' + member.name[:80])
            if member.isfile():
                yield path, member, archive


def validate_tar(payload, inside=None, outside=()):
    return [path for path, _, _ in members(payload, inside, outside)]


def tar_fingerprint(payload, leave_out=()):
    """What `Device.fingerprint` answers for app data holding exactly these files: the host's proof
    that a copy is complete."""
    lines, count = [], 0
    for path, member, archive in members(payload):
        if under(path, leave_out):
            continue
        digest, size = hashlib.sha256(), 0
        with archive.extractfile(member) as stream:
            for block in iter(lambda: stream.read(1 << 20), b''):
                digest.update(block)
                size += len(block)
        lines += ['%s  ./%s' % (digest.hexdigest(), path), '%d ./%s' % (size, path)]
        count += 1
    encoded = sorted(line.encode('utf-8', 'surrogateescape') for line in lines)
    return {'digest': sha(b''.join(line + b'\n' for line in encoded)), 'files': count}


class Phone:
    """The command layer. `state` is corpus/lab of the main checkout; None for host-only verbs."""

    def __init__(self, device, state):
        self.device = device
        self.state = Path(state) if state is not None else None
        self.read = {}  # sha256 -> facts of an installed APK pulled during this call

    # --- helpers ---------------------------------------------------------
    def app(self):
        return self.device.package(PKG)

    def identity(self):
        app, test = self.device.package(PKG), self.device.package(TEST)
        lab = self.device.inventory(LAB_FOLDER) if self.readable(app) else None
        return {'app_sha256': app.get('sha256'), 'test_sha256': test.get('sha256'),
                'lab_sha256': sha(json.dumps(lab, sort_keys=True).encode()) if lab is not None else None}

    def meta(self, verb, **extra):
        folder = self.state / 'runs' / (time.strftime('%Y%m%dT%H%M%S') + '-' + verb + '-' + uuid.uuid4().hex[:6])
        folder.mkdir(parents=True, exist_ok=False)
        record = dict(verb=verb, ts=time.strftime('%Y-%m-%dT%H:%M:%S'), **self.identity(), **extra)
        (folder / 'meta.json').write_text(json.dumps(record, indent=1, sort_keys=True))
        return folder

    def not_live(self, verb):
        ime = self.device.ime()
        if ime['bound'] or ime['input_shown']:
            raise Refused(verb + ' refused: the dictation keyboard is in use right now')

    def markers(self):
        """sha256 -> marker of every APK `install` accepted or a later verb read from the phone."""
        path = self.state / 'markers.json'
        return json.loads(path.read_text()) if path.is_file() else {}

    def remember(self, infos):
        self.state.mkdir(parents=True, exist_ok=True)
        known = {**self.markers(), **{info['sha256']: info['marker'] for info in infos}}
        (self.state / 'markers.json').write_text(json.dumps(known, indent=1, sort_keys=True))

    def installed_apk(self, package):
        """Marker and debuggability of an installed APK: as recorded for its hash, else read from the
        pulled APK. Never `run-as`, so it answers for release too."""
        marker = self.markers().get(package['sha256'])
        if marker is not None:
            return {'sha256': package['sha256'], 'marker': marker, 'debuggable': marker.startswith('layout=test;')}
        if package['sha256'] not in self.read:
            with tempfile.TemporaryDirectory() as folder:
                local = Path(folder) / 'installed.apk'
                self.device.pull_apk(package['apk_path'], local)
                info = self.device.apk_info(local)
            if info['sha256'] != package['sha256']:
                raise Failed('pulled APK differs from the installed one')
            self.read[info['sha256']] = info
        return self.read[package['sha256']]

    def readable(self, app):
        """Whether `run-as` reaches app data: only on a debuggable build, so never on release."""
        return bool(app['installed'] and self.installed_apk(app)['debuggable'])

    def layout(self, app):
        """What is installed: None, 'owner' (release), 'test' (lab build) or 'unmarked' (a debuggable
        build from before ADR-028, where the one-time switch starts). Anything else is refused."""
        if not app['installed']:
            return None
        facts = self.installed_apk(app)
        if facts['marker'] is None and facts['debuggable']:
            return 'unmarked'
        try:
            return marker_layout(facts)
        except Refused as error:
            raise Refused('installed %s' % error) from None

    def lab_build(self, verb):
        """The installed app and test package when they are one lab build; else refuse."""
        app, test = self.device.package(PKG), self.device.package(TEST)
        if not app['installed']:
            raise Refused(verb + ' refused: app not installed')
        if not test['installed']:
            raise Refused(verb + ' refused: test package is not installed; use install APP.apk TEST.apk')
        try:
            facts = self.installed_apk(app)
            layout = marker_layout(facts)
            if layout != 'test':
                raise Refused('app is the release build (owner layout); nothing runs on it')
            both = [facts, self.installed_apk(test)]
            marker_layout(*both)
        except Refused as error:
            raise Refused('%s refused: installed %s' % (verb, error)) from None
        self.remember(both)
        return app, test

    def visit_record(self, label):
        path = self.state / 'visits' / name(label) / 'visit.json'
        record = json.loads(path.read_text())
        if not isinstance(record, dict) or set(record) != VISIT_FIELDS or record['name'] != path.parent.name:
            raise Refused('unreadable Visit record %s; nothing runs until it is repaired' % path.parent.name)
        return record

    def visits(self):
        """Every kept Visit record, oldest first. One per Visit at visits/NAME/visit.json: the pulled
        release APK (or none), the Visit copy, fingerprint and model inventory at start, the lab
        builds installed during it, and when it ended. Copy, fingerprint and model are null until
        the Visit copy is taken."""
        records = [self.visit_record(path.parent.name) for path in sorted((self.state / 'visits').glob('*/visit.json'))]
        return sorted(records, key=lambda record: record['started'])

    def open_visit(self):
        current = [visit for visit in self.visits() if visit['ended'] is None]
        return current[-1] if current else None

    def save(self, visit):
        path = self.state / 'visits' / name(visit['name']) / 'visit.json'
        fresh = path.with_name('visit.json.new')
        fresh.write_text(json.dumps(visit, indent=1, sort_keys=True))
        os.replace(fresh, path)

    def visit_copy(self, visit):
        return self.state / 'visits' / name(visit['name']) / name(visit['copy']['archive'])

    def same_owner_data(self, visit, verb):
        if self.device.fingerprint() != visit['fingerprint']:
            raise Refused('%s refused: owner data differs from the Visit copy %s; restore %s first'
                          % (verb, self.visit_copy(visit), visit['name']))

    def in_visit(self, verb):
        """The open Visit, when the installed lab build belongs to it and owner data equals its copy."""
        app, test = self.lab_build(verb)
        visit = self.open_visit()
        if visit is None:
            raise Refused(verb + ' refused: no Visit is open; a Visit starts by installing the lab build over release')
        if visit['copy'] is None:
            raise Refused('%s refused: Visit %s has no copy of owner data yet; install the lab build again'
                          % (verb, visit['name']))
        if not any(build['app_sha256'] == app['sha256'] and build['test_sha256'] == test['sha256']
                   for build in visit['lab_builds']):
            raise Refused('%s refused: the installed lab build is not part of Visit %s' % (verb, visit['name']))
        self.same_owner_data(visit, verb)
        return visit

    def kept_model(self):
        """Lab-folder paths of the speech-model files: the files of the kept model copy, corpus/lab/model.
        Everything else in the lab folder is test output. The wrapper knows no model by name."""
        folder = self.state / 'model'
        if not folder.is_dir():
            raise Refused('no kept model copy at %s: put the speech-model files there as they lie in files/lab '
                          '(an empty folder when the phone holds none); without it no model file is protected' % folder)
        validate_directory(folder)
        return sorted(path.relative_to(folder).as_posix() for path in folder.rglob('*') if path.is_file())

    def model_inventory(self):
        lab = self.device.inventory(LAB_FOLDER) or {}
        return {path: lab[path] for path in self.kept_model() if path in lab}

    def changed_model(self, visit):
        lab = self.device.inventory(LAB_FOLDER) or {}
        return sorted(path for path, digest in visit['model'].items() if lab.get(path) != digest)

    def facts(self):
        """What a release update must leave alone; nothing else can be read once release is installed."""
        app, ime = self.app(), self.device.ime()
        return {'uid': app.get('uid'), 'first_install': app.get('first_install'),
                'microphone_granted': MICROPHONE in app.get('granted', []),
                'keyboard_enabled': ime['enabled'], 'keyboard_selected': ime['selected']}

    def lock(self):
        import fcntl
        self.state.mkdir(parents=True, exist_ok=True)
        handle = (self.state / '.phone.lock').open('a')
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Refused('another phone command is running') from None
        return handle

    # --- verbs -----------------------------------------------------------
    def status(self):
        try:
            self.device.connect()
        except Failed as error:
            return {'connected': False, 'reason': str(error)}
        return {'connected': True, 'model': MODEL}

    def device_info(self):
        return {'props': self.device.props(), 'thermal_status': self.device.thermal(),
                'driver_libs': self.device.driver_libs()}

    def app_info(self):
        info = {'app': self.app(), 'test': self.device.package(TEST), 'ime': self.device.ime(),
                'futo': {p: self.device.package(p) for p in FUTO}}
        info['app']['layout'] = self.layout(info['app'])
        info['lab'] = self.device.inventory(LAB_FOLDER) if self.readable(info['app']) else None
        for key in ('app', 'test'):
            info[key].pop('apk_path', None)
        visit = self.open_visit()
        info['visit'] = visit and visit['name']
        return info

    def check(self, app_apk, test_apk=None):
        """Host-only APK acceptance check; run it in the build step, before the phone stage."""
        infos = [self.device.apk_info(app_apk)] + ([self.device.apk_info(test_apk)] if test_apk else [])
        if infos[0]['package'] != PKG or (test_apk and infos[1]['package'] != TEST):
            raise Refused('arguments are APP.apk then TEST.apk')
        if len({i['signer'] for i in infos}) != 1:
            raise Refused('app and test APK must share one signer')
        marker_layout(*infos)
        return infos

    def install(self, app_apk, test_apk=None, promote=False):
        """Lab build: starts a Visit (over release, over the unmarked build of the switch, or on a
        phone without the app) or continues the open one. Release: ends the Visit."""
        infos = self.check(app_apk, test_apk)
        # Signer continuity against the installed app is enforced by Android itself.
        self.not_live('install')
        app = self.app()
        try:
            current = self.layout(app)
        except Refused as error:
            raise Refused('install refused: %s' % error) from None
        if marker_layout(*infos) == 'owner':
            return self.install_release(app_apk, infos[0], app, current, promote)
        if promote:
            raise Refused('install refused: --promote names a new release, never a lab build')
        if not test_apk:
            raise Refused('install refused: a lab build is installed together with its test APK')
        return self.install_lab(app_apk, test_apk, infos, app, current)

    def put(self, apks, infos):
        self.remember(infos)  # known by hash before it is installed: no later verb pulls it to read its marker
        for apk in apks:
            self.device.install(apk)
        after = self.identity()
        if [after['app_sha256'], after['test_sha256']][:len(infos)] != [info['sha256'] for info in infos]:
            raise Failed('installed identity does not match the given APKs')
        return after

    def install_lab(self, app_apk, test_apk, infos, app, current):
        build = {'app_sha256': infos[0]['sha256'], 'test_sha256': infos[1]['sha256'], 'marker': infos[0]['marker']}
        visit, switch = None, None
        if current == 'test':
            visit = self.open_visit()
            if visit is None:
                raise Refused('install refused: a lab build is installed outside any Visit; '
                              'install a release with --promote')
            if visit['copy'] is not None:
                if not any(known['app_sha256'] == app['sha256'] for known in visit['lab_builds']):
                    raise Refused('install refused: the installed lab build is not part of Visit ' + visit['name'])
                self.same_owner_data(visit, 'install')
        elif current == 'unmarked':
            switch = self.switch_copy(app)
        if visit is None or visit['copy'] is None:
            self.kept_model()  # refused here, before anything changes on the phone
        started = visit is None
        if started:
            visit = self.start_visit(app if current == 'owner' else None)
        folder = self.meta('install', apks=[info['sha256'] for info in infos], visit=visit['name'])
        try:
            after = self.put([app_apk, test_apk], infos)
        except Exception:
            if started and self.app().get('sha256') == app.get('sha256'):  # nothing was replaced: no Visit began
                shutil.rmtree(self.state / 'visits' / visit['name'])
            raise
        if visit['copy'] is None:
            self.take_copy(visit, build, switch)
        else:
            if self.device.fingerprint() != visit['fingerprint']:
                raise Failed('owner data changed while the lab build was updated; Visit copy: %s' % self.visit_copy(visit))
            if build not in visit['lab_builds']:
                visit['lab_builds'].append(build)
                self.save(visit)
        self.device.empty_test_folders()
        return {'outcome': 'installed', **after, 'visit': visit['name'], 'visit_started': started,
                'copy': str(self.visit_copy(visit)), 'fingerprint': visit['fingerprint'],
                'model_files': len(visit['model']), 'meta': str(folder / 'meta.json')}

    def start_visit(self, release):
        """A new Visit record, not yet usable: the release APK is pulled, the copy comes after the install."""
        stamp, count = time.strftime('%Y%m%dT%H%M%S'), 1
        label = stamp
        while (self.state / 'visits' / label).exists():
            count += 1
            label = '%s-%d' % (stamp, count)
        folder = self.state / 'visits' / label
        folder.mkdir(parents=True)
        pulled = None
        try:
            if release is not None:
                self.device.pull_apk(release['apk_path'], folder / 'release.apk')
                if sha_file(folder / 'release.apk') != release['sha256']:
                    raise Failed('pulled APK differs from the installed one')
                pulled = {'apk': 'release.apk', 'sha256': release['sha256']}
        except Exception:
            shutil.rmtree(folder)
            raise
        visit = {'name': label, 'started': time.strftime('%Y-%m-%dT%H:%M:%S'), 'ended': None, 'release': pulled,
                 'copy': None, 'fingerprint': None, 'model': None, 'lab_builds': []}
        self.save(visit)
        return visit

    def take_copy(self, visit, build, switch):
        """The Visit copy, taken right after the install and before anything is emptied or run."""
        payload = self.device.copy(OWNER_SKIP)
        validate_tar(payload, outside=OWNER_SKIP)
        fingerprint = self.device.fingerprint()
        if tar_fingerprint(payload) != fingerprint:
            raise Failed('the copy of owner data does not hold what the fingerprint sees; Visit %s has no copy, '
                         'nothing runs' % visit['name'])
        if switch is not None and fingerprint != switch['fingerprint']:
            raise Failed('owner data changed while the lab build replaced the unmarked build; '
                         'restore --switch %s' % switch['name'])
        (self.state / 'visits' / visit['name'] / 'owner-data.tar').write_bytes(payload)
        visit.update(copy={'archive': 'owner-data.tar', 'sha256': sha(payload)}, fingerprint=fingerprint,
                     model=self.model_inventory(), lab_builds=[build])
        self.save(visit)

    def switch_copy(self, app):
        """The switch copy of the installed unmarked build whose fingerprint is the current one; else refuse."""
        copies = []
        for path in sorted((self.state / 'snapshots').glob('*/snapshot.json')):
            record = json.loads(path.read_text())
            if record.get('kind') == 'switch' and record.get('app_sha256') == app['sha256']:
                copies.append({**record, 'name': path.parent.name})
        if not copies:
            raise Refused('install refused: the installed build has no marker and no switch copy; '
                          'snapshot --switch NAME first')
        fingerprint = self.device.fingerprint()
        current = [record for record in copies if record['fingerprint'] == fingerprint]
        if not current:
            raise Refused('install refused: app data changed since the switch copy %s was taken; '
                          'snapshot --switch again under a new name' % copies[-1]['name'])
        return current[-1]

    def install_release(self, app_apk, info, app, current, promote):
        visit, pulled, after_check = None, None, 'none: no Visit ends'
        if current == 'unmarked':
            raise Refused('install refused: the installed build has no marker; the switch goes through the lab '
                          'build: snapshot --switch NAME, install the lab build, then install the release with --promote')
        if current == 'test':
            visit = self.open_visit()
            pulled = visit['release'] if visit else None
            back = pulled is not None and info['sha256'] == pulled['sha256']
            if visit is None:
                if not promote:
                    raise Refused('install refused: a lab build is installed outside any Visit; '
                                  'a release goes over it only with --promote')
            elif visit['copy'] is None:
                if not back:
                    raise Refused('install refused: Visit %s has no copy of owner data yet; only its pulled release '
                                  'goes back, or install the lab build again' % visit['name'])
                after_check = 'skipped: the Visit never got its copy, so nothing ran in it'
            else:
                self.same_owner_data(visit, 'install')
                changed = self.changed_model(visit)
                if changed:
                    raise Refused('install refused: speech-model files differ from Visit start (%s); push the kept '
                                  'model copy %s with --model' % (', '.join(changed)[:300], self.state / 'model'))
                after_check = 'owner data and speech model as at Visit start'
                if not back and not promote:
                    was = ('ends with its pulled release %s' % (self.state / 'visits' / visit['name'] / pulled['apk'])
                           if pulled else 'pulled no release')
                    raise Refused('install refused: Visit %s %s; another release is a promotion and needs --promote'
                                  % (visit['name'], was))
        elif info['sha256'] != app.get('sha256') and not promote:
            raise Refused('install refused: a release other than the installed one is a promotion and needs --promote')
        before = self.facts() if app['installed'] else None
        folder = self.meta('install', apks=[info['sha256']], visit=visit and visit['name'])
        after = self.put([app_apk], [info])
        if visit is not None:
            visit['ended'] = time.strftime('%Y-%m-%dT%H:%M:%S')
            self.save(visit)
        facts = self.facts()
        return {'outcome': 'installed', **after, 'visit_ended': visit and visit['name'], 'after_check': after_check,
                'promoted': info['sha256'] != app.get('sha256') and not (pulled and info['sha256'] == pulled['sha256']),
                'facts': facts, 'facts_before': before,
                'facts_changed': sorted(key for key in facts if before is not None and facts[key] != before[key]),
                'meta': str(folder / 'meta.json')}

    def push(self, directory, model=False):
        """Make the lab folder hold DIR. A speech-model file of the Visit's inventory is left alone:
        kept when DIR lacks it, refused when DIR would change it; `model` lifts both."""
        directory = validate_directory(directory)
        visit = self.in_visit('push')
        expected = {p.relative_to(directory).as_posix(): sha_file(p) for p in directory.rglob('*') if p.is_file()}
        before = self.device.inventory(LAB_FOLDER) or {}
        protected = set() if model else set(visit['model'])
        changed = {item for item, digest in expected.items() if before.get(item) != digest}
        if changed & protected:
            raise Refused('push refused: it would overwrite speech-model files (%s); only with --model'
                          % ', '.join(sorted(changed & protected))[:300])
        kept = (set(before) - set(expected)) & protected
        removed = set(before) - set(expected) - protected
        if changed or removed:
            self.device.push(directory, changed, removed)
        actual = self.device.inventory(LAB_FOLDER) or {}
        if actual != {**expected, **{item: before[item] for item in kept}}:
            raise Failed('pushed inventory differs from the host directory')
        folder = self.meta('push', target=LAB_FOLDER, files=len(expected), sent=len(changed), removed=len(removed),
                           model=model)
        return {'outcome': 'pushed' if changed or removed else 'unchanged', 'target': LAB_FOLDER,
                'files': len(expected), 'sent': len(changed), 'removed': len(removed), 'model_files_kept': len(kept),
                'model_differs_from_visit_start': self.changed_model(visit), 'meta': str(folder / 'meta.json')}

    def pull(self, paths, to=None):
        rels = [name(p, PULL_ROOTS) for p in paths]
        app = self.app()
        if not app['installed']:
            raise Refused('pull refused: app not installed')
        if not self.readable(app):
            raise Refused("pull refused: nothing reads the release build's data; pull during a Visit")
        payload = self.device.tar(*rels)
        validate_tar(payload, inside=rels)
        dest = Path(to) if to else self.state / 'pull' / time.strftime('%Y%m%dT%H%M%S')
        dest.mkdir(parents=True, exist_ok=False)
        count = 0
        for path, member, archive in members(payload, inside=rels):
            target = dest / path
            target.parent.mkdir(parents=True, exist_ok=True)
            with archive.extractfile(member) as src, target.open('xb') as out:
                shutil.copyfileobj(src, out)
            count += 1
        return {'outcome': 'pulled', 'files': count, 'path': str(dest)}

    @staticmethod
    def extras(items):
        pairs = []
        for item in items:
            key, eq, value = item.partition('=')
            if not eq or not re.fullmatch(r'[A-Za-z][A-Za-z0-9_]*', key) or len(value) > 256:
                raise Refused('extras are key=value with a short value')
            pairs.append((key, value))
        return pairs

    def instrumented(self, verb, classes, pairs, timeout, **record):
        """One instrumentation with its output and our app's logcat kept: (folder, output, whether it ended in order)."""
        folder = self.meta(verb, classes=classes, extras=pairs, **record)
        since = self.device.device_time()
        uid = self.app()['uid']
        output = self.device.instrument(classes, pairs, timeout)
        (folder / 'instrumentation.txt').write_text(output)
        (folder / 'logcat.txt').write_text(self.device.logcat(uid, since=since))
        return folder, output, bool(re.search(r'^OK \(\d+ tests?\)', output, re.M)) and 'INSTRUMENTATION_CODE: -1' in output

    def unchanged(self, verb, visit, folder):
        if self.device.fingerprint() != visit['fingerprint']:
            raise Failed('owner data changed during this %s; Visit copy: %s; run output: %s'
                         % (verb, self.visit_copy(visit), folder))

    def run(self, classes, extras, timeout=1800):
        if not CLASSES.fullmatch(classes):
            raise Refused('unsupported test class list')
        pairs = self.extras(extras)
        if any(item.startswith(LAB_RUN + '.') for item in classes.split(',')):
            raise Refused('run refused: %s holds Lab run classes; they measure and never run as tests; use measure'
                          % LAB_RUN)
        visit = self.in_visit('run')
        self.not_live('run')
        folder, _, ok = self.instrumented('run', classes, pairs, timeout)
        self.unchanged('run', visit, folder)
        return {'outcome': 'passed' if ok else 'failed', 'path': str(folder),
                'lab': self.device.inventory(LAB_FOLDER)}

    def measure(self, classes, arguments, timeout=7200):
        """A Lab run: only classes of the Lab run package, on copies of the named owner recordings or
        receipts placed in the lab folder for the run and removed after it. Completed or incomplete."""
        if not CLASSES.fullmatch(classes):
            raise Refused('unsupported class list')
        if not all(item.startswith(LAB_RUN + '.') for item in classes.split(',')):
            raise Refused('measure refused: it runs only Lab run classes, those under %s; tests go through run' % LAB_RUN)
        inputs = [name(path, INPUT_ROOTS) for item in arguments if item.startswith('inputs=')
                  for path in item[len('inputs='):].split(',')]
        if any(a == b or under(a, (b,)) for i, a in enumerate(inputs) for j, b in enumerate(inputs) if i != j):
            raise Refused('measure refused: an input is named twice or lies inside another')
        pairs = self.extras(item for item in arguments if not item.startswith('inputs='))
        visit = self.in_visit('measure')
        self.not_live('measure')
        folder_name = LAB_RUN_INPUTS[len(LAB_FOLDER) + 1:]
        model = set(self.kept_model())
        if any(under(path, (folder_name,)) for path in model | set(visit['model'])):
            raise Refused('measure refused: a speech-model file lies in %s, which measure empties' % LAB_RUN_INPUTS)
        before = self.device.inventory(LAB_FOLDER) or {}
        folder = None
        try:
            copied = self.device.place_inputs(inputs)
            folder, output, ok = self.instrumented('measure', classes, pairs, timeout, inputs=inputs)
        finally:
            self.device.remove_inputs()
            if folder is not None:
                self.unchanged('measure', visit, folder)
        after = self.device.inventory(LAB_FOLDER) or {}
        if any(under(path, (folder_name,)) for path in after):
            raise Failed('copies of owner data are still in %s; run output: %s' % (LAB_RUN_INPUTS, folder))
        completed, incomplete = output.count(LAB_RUN_COMPLETED), output.count(LAB_RUN_INCOMPLETE)
        return {'outcome': 'completed' if ok and completed and not incomplete else 'incomplete',
                'lab_runs_completed': completed, 'lab_runs_incomplete': incomplete, 'inputs': copied,
                'outputs': sorted(path for path, digest in after.items() if before.get(path) != digest and path not in model),
                'model_differs_from_visit_start': sorted(path for path, digest in visit['model'].items()
                                                         if after.get(path) != digest),
                'path': str(folder)}

    def logs(self, since=None):
        app = self.app()
        if not app['installed']:
            raise Refused('app not installed')
        return {'logs': self.device.logcat(app['uid'], since=since)}

    def crash(self):
        return {'crash': self.device.logcat(None, crash=True)}

    def stop(self):
        self.in_visit('stop')
        self.not_live('stop')
        self.device.stop()
        return {'outcome': 'stopped'}

    def snapshot(self, label, switch=False):
        """A further copy of owner data on the lab build; with `switch`, the switch copy: all app data
        but the speech model, and both APKs of the unmarked build, taken before the one-time switch."""
        folder = self.state / 'snapshots' / name(label)
        if folder.exists():
            raise Refused('snapshot exists: ' + label)
        app, test = self.device.package(PKG), self.device.package(TEST)
        current = self.layout(app)
        if switch and current != 'unmarked':
            raise Refused('snapshot --switch refused: it copies the unmarked debuggable build of the switch; '
                          'that is not what is installed')
        if not switch and current != 'test':
            raise Refused('snapshot refused: ' + {
                'unmarked': 'the installed build has no marker; use snapshot --switch NAME',
                'owner': "nothing reads the release build's data; a Visit takes its copy when the lab build is installed",
            }.get(current, 'app not installed'))
        model = [LAB_FOLDER + '/' + path for path in self.kept_model()] if switch else []
        skip = tuple(model) + SYSTEM_FILES if switch else OWNER_SKIP
        folder.mkdir(parents=True)
        try:
            payload = self.device.copy(skip)
            held = validate_tar(payload, outside=skip)
            fingerprint = self.device.fingerprint()
            if tar_fingerprint(payload, leave_out=EXCLUDED) != fingerprint:
                raise Failed('the copy does not hold what the fingerprint sees; nothing kept')
            record = {'kind': 'switch' if switch else 'owner', 'archive': 'data.tar', 'data_sha256': sha(payload),
                      'fingerprint': fingerprint, 'app_sha256': app['sha256'], 'test_sha256': test.get('sha256'),
                      'ts': time.strftime('%Y-%m-%dT%H:%M:%S')}
            if switch:
                lacking = sorted(what for what, place in SWITCH_HOLDS.items()
                                 if not any(path.startswith(place) for path in held))
                if lacking:
                    raise Refused('snapshot --switch refused: the copy holds no %s; nothing kept' % ', '.join(lacking))
                for package, local in ((app, 'app.apk'), (test, 'test.apk')):
                    if package['installed']:
                        self.device.pull_apk(package['apk_path'], folder / local)
                        if sha_file(folder / local) != package['sha256']:
                            raise Failed('pulled APK differs from the installed one')
                record.update(model_files=model, granted=app['granted'], ime=self.device.ime())
            (folder / 'data.tar').write_bytes(payload)
            (folder / 'snapshot.json').write_text(json.dumps(record, indent=1, sort_keys=True))
        except Exception:
            shutil.rmtree(folder)
            raise
        return {'outcome': 'snapshotted', 'path': str(folder), 'files': len(held), **record}

    def kept_copy(self, label, switch):
        """Archive, digest, fingerprint, what a restore leaves alone, and the record, of a Visit copy or a snapshot."""
        visit = (self.state / 'visits' / name(label) / 'visit.json').is_file()
        folder = self.state / 'snapshots' / label
        record = json.loads((folder / 'snapshot.json').read_text()) if (folder / 'snapshot.json').is_file() else None
        if switch:
            if record is None or record.get('kind') != 'switch':
                raise Refused('restore --switch refused: %s is no switch copy' % label)
            return (folder / 'data.tar', record['data_sha256'], record['fingerprint'],
                    tuple(record['model_files']) + SYSTEM_FILES, record)
        if visit and folder.exists():
            raise Refused('restore refused: %s names a Visit and a snapshot' % label)
        if visit:
            record = self.visit_record(label)
            if record['copy'] is None:
                raise Refused('restore refused: Visit %s never got its copy' % label)
            return self.visit_copy(record), record['copy']['sha256'], record['fingerprint'], OWNER_SKIP, record
        if record is None:
            raise Refused('restore refused: no Visit and no snapshot named ' + label)
        if record.get('kind') == 'switch':
            raise Refused('restore refused: %s is a switch copy; use restore --switch %s' % (label, label))
        if record.get('kind') != 'owner':
            raise Refused('restore refused: %s was taken before ADR-028 and holds the model and test output; '
                          'it stays with the owner' % label)
        return folder / 'data.tar', record['data_sha256'], record['fingerprint'], OWNER_SKIP, record

    def restore(self, label, switch=False):
        """Owner data only: the lab folder (speech model, test output) and the test folders stay as they
        are. With `switch`: all app data but the speech model, and the retained unmarked APKs when
        another build is installed."""
        archive, digest, fingerprint, skip, record = self.kept_copy(label, switch)
        payload = archive.read_bytes()
        if sha(payload) != digest:
            raise Refused('restore refused: the copy changed since it was taken')
        validate_tar(payload, outside=skip)
        if tar_fingerprint(payload, leave_out=EXCLUDED) != fingerprint:
            raise Refused('restore refused: the copy does not hold what its fingerprint names')
        folder = self.state / 'snapshots' / label
        apks = [(key, folder / local) for key, local in (('app_sha256', 'app.apk'), ('test_sha256', 'test.apk'))
                if switch and record.get(key)]
        for key, local in apks:
            if not local.is_file() or sha_file(local) != record[key]:
                raise Refused('restore refused: a retained APK changed since the switch copy was taken')
        self.not_live('restore')
        if not switch:
            try:
                current = self.layout(self.app())
            except Refused:
                current = None
            if current != 'test':
                raise Refused('restore refused: owner data is written only under the lab build; install it first')
        meta = self.meta('restore', copy=label, switch=switch)
        installed = self.identity()
        for key, local in apks:
            if installed[key] != record[key]:
                self.device.install(local, downgrade=True)
        if switch and self.identity()['app_sha256'] != record['app_sha256']:
            raise Failed('the retained unmarked APK is not installed; app data left as it was')
        self.device.stop()
        self.device.replace(payload, skip)
        if self.device.fingerprint() != fingerprint:
            raise Failed('restored owner data does not equal the copy %s; nothing runs until it does' % archive)
        result = {'outcome': 'restored', **self.identity(), 'copy': str(archive), 'fingerprint': fingerprint,
                  'meta': str(meta / 'meta.json')}
        if switch:
            result['not_restored'] = {
                'granted_permissions_missing': sorted(set(record['granted']) - set(self.app()['granted'])),
                'ime_state_then': record['ime'], 'ime_state_now': self.device.ime(),
                'note': 'microphone grant, IME enablement/selection and FUTO toggles are not restorable here'}
        return result

    def forget(self, label):
        """Delete a Visit record with its pulled release APK and its copy, once the Visit ended; it ends
        only through the after-check of the release install."""
        folder = self.state / 'visits' / name(label)
        if folder.is_symlink() or not (folder / 'visit.json').is_file():
            raise Refused('forget refused: no Visit named ' + label)
        visit = self.visit_record(label)
        if visit['ended'] is None:
            raise Refused('forget refused: Visit %s has not ended; until its release is back its copy is the '
                          'only one of owner data' % label)
        shutil.rmtree(folder)
        return {'outcome': 'forgotten', 'visit': label}

    def uninstall(self):
        token = self.state / '.allow-uninstall'
        if not token.is_file():
            raise Refused('uninstall needs the user to create ' + str(token))
        if self.device.ime()['enabled']:
            raise Refused('uninstall refused while the dictation keyboard is enabled; disable it first')
        self.not_live('uninstall')
        self.meta('uninstall')
        token.unlink()
        for pkg in (TEST, PKG):
            if self.device.package(pkg)['installed']:
                self.device.uninstall(pkg)
        return {'outcome': 'uninstalled'}


