#!/usr/bin/env -S python3 -I
"""App-scoped phone access for ch.og.dictation (ADR-024).

Runs through `.claude/hooks/phone`, which executes the copy of this file on
GitHub `main`. Every device command is built from fixed templates with the
package constant; caller strings reach the device only as validated names.

Exit 0: success, one JSON object on stdout.
Exit 3: `refused: <reason>` (policy).  Exit 1: `failed: <reason>` (device/transport).
"""
import hashlib
import io
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import uuid
import zipfile
from pathlib import Path

PKG = 'ch.og.dictation'
TEST = PKG + '.test'
RUNNER = TEST + '/androidx.test.runner.AndroidJUnitRunner'
MODEL = 'Pixel 10 Pro XL'
FUTO = ('org.futo.inputmethod.latin', 'org.futo.inputmethod.latin.playstore',
        'org.futo.voiceinput', 'org.futo.voiceinput.playstore')
PROPS = ('ro.product.model', 'ro.build.version.release', 'ro.build.version.sdk',
         'ro.build.version.security_patch', 'ro.build.id', 'ro.soc.manufacturer', 'ro.soc.model',
         'ro.hardware', 'ro.hardware.vulkan', 'ro.hardware.egl', 'ro.opengles.version')
DRIVER_LIBS = re.compile(r'^(libOpenCL.*|libedgetpu.*|vulkan\..*|libGLES.*|libllvm-glnext.*)\.so$')
PERMISSIONS = {PKG: {'android.permission.RECORD_AUDIO', 'android.permission.WAKE_LOCK'}}
PERMISSIONS[TEST] = PERMISSIONS[PKG]
NETWORK = {'android.permission.INTERNET', 'android.permission.ACCESS_NETWORK_STATE',
           'android.permission.QUERY_ALL_PACKAGES'}
DATA_DIRS = ('files', 'shared_prefs', 'databases')
PULL_ROOTS = ('files/lab', 'files/benchmark')
NAME = re.compile(r'[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*')
LIVE_VERBS = ('install', 'restore', 'stop', 'uninstall')


class Refused(Exception):
    """Policy refusal; retrying the same call will not help."""


class Failed(Exception):
    """Device or transport failure; the call may be retried."""


def name(value, root=None):
    if not NAME.fullmatch(value) or '..' in value.split('/'):
        raise Refused('unsupported name: ' + value[:60])
    if root is not None and not any(value == r or value.startswith(r + '/') for r in root):
        raise Refused('path outside ' + ' or '.join(root))
    return value


def sha(data):
    return hashlib.sha256(data).hexdigest()


def sha_file(path):
    digest = hashlib.sha256()
    with open(path, 'rb') as stream:
        for block in iter(lambda: stream.read(1 << 20), b''):
            digest.update(block)
    return digest.hexdigest()


class Device:
    """The adb adapter. All argv are assembled here, nowhere else."""

    def __init__(self, sdk, runner=subprocess.run):
        self.sdk = Path(sdk)
        self.adb = self.sdk / 'platform-tools/adb'
        self.runner = runner
        self.serial = None

    def run(self, *args, timeout=60, binary=False, check=True, stdin=None):
        argv = [str(self.adb)] + (['-s', self.serial] if self.serial else []) + list(args)
        try:
            result = self.runner(argv, capture_output=True, text=not binary, timeout=timeout, input=stdin)
        except subprocess.TimeoutExpired:
            raise Failed('device command timed out after %ds' % timeout) from None
        except OSError as error:
            raise Failed('cannot start adb: ' + error.strerror) from None
        if check and result.returncode:
            err = result.stderr if isinstance(result.stderr, str) else result.stderr.decode(errors='replace')
            raise Failed(self.redact(err.strip()[-400:] or 'adb exited %d' % result.returncode))
        return result.stdout

    def redact(self, text):
        text = text.replace(str(self.adb), 'adb')
        return text.replace(self.serial, '<serial>') if self.serial else text

    def connect(self):
        if self.serial:
            return
        rows = [line.split() for line in self.run('devices').splitlines()[1:] if line.strip()]
        if len(rows) != 1 or rows[0][1:2] != ['device']:
            raise Failed('need exactly one authorized phone; found %d' % len(rows))
        self.serial = rows[0][0]
        if self.shell('getprop ro.product.model').strip() != MODEL:
            self.serial = None
            raise Refused('connected device is not the permitted ' + MODEL)

    def shell(self, code, **kw):
        self.connect()
        return self.run('shell', code, **kw)

    def private(self, code, **kw):
        return self.shell('run-as %s sh -c %s' % (PKG, shlex.quote(code)), **kw)

    # --- read-only -------------------------------------------------------
    def props(self):
        return {p: self.shell('getprop ' + p).strip() for p in PROPS}

    def thermal(self):
        dump = self.shell('dumpsys thermalservice')
        status = re.search(r'^Thermal Status: *(\d)', dump, re.M)
        return int(status.group(1)) if status else None

    def driver_libs(self):
        names = self.shell('ls /vendor/lib64 /system/lib64 2>/dev/null').split()
        return sorted({n for n in names if DRIVER_LIBS.match(n)})

    def package(self, pkg):
        if pkg not in (PKG, TEST) + FUTO:
            raise Refused('package outside scope')
        paths = [l[8:] for l in self.shell('pm path ' + pkg).splitlines() if l.startswith('package:')]
        if not paths:
            return {'installed': False}
        dump = self.shell('dumpsys package ' + pkg)
        info = {'installed': True,
                'versionCode': int((re.search(r'\bversionCode=(\d+)', dump) or [0, 0])[1]),
                'versionName': (re.search(r'\bversionName=(\S+)', dump) or [0, None])[1]}
        if pkg in FUTO:
            return info
        info['sha256'] = self.shell('sha256sum -- ' + shlex.quote(paths[0])).split()[0]
        info['apk_path'] = paths[0]
        info['uid'] = int((re.search(r'\buserId=(\d+)', dump) or [0, 0])[1])
        info['granted'] = sorted(set(re.findall(r'^\s+(android\.permission\.\S+): granted=true', dump, re.M)))
        pid = self.shell('pidof ' + pkg, check=False).split()
        info['pid'] = int(pid[0]) if pid and pid[0].isdigit() else None
        return info

    def ime(self):
        """Booleans about our IME only; nothing about other keyboards."""
        dump = self.shell('dumpsys input_method')
        enabled = any(l.strip().startswith(PKG + '/') for l in self.shell('ime list -s').splitlines())
        selected = bool(re.search(r'^\s*(?:mCurMethodId|mSelectedMethodId)=' + re.escape(PKG) + '/', dump, re.M))
        bound = bool(re.search(r'^\s*(?:mCurId|mCurImeId)=' + re.escape(PKG) + '/', dump, re.M))
        shown = bool(re.search(r'^\s*mInputShown=true', dump, re.M))
        return {'enabled': enabled, 'selected': selected, 'bound': bound, 'input_shown': bound and shown}

    def inventory(self, rel):
        code = ('cd %s 2>/dev/null || exit 3; [ -z "$(find . -type l -print -quit)" ] || exit 4; '
                'find . -type f -exec sha256sum {} +') % shlex.quote(rel)
        self.connect()
        result = self.runner([str(self.adb), '-s', self.serial, 'shell', 'run-as %s sh -c %s' % (PKG, shlex.quote(code))],
                             capture_output=True, text=True, timeout=120)
        if result.returncode == 3:
            return None
        if result.returncode == 4:
            raise Refused('symlink inside app data; not touching it')
        if result.returncode:
            raise Failed(self.redact(result.stderr.strip()[-300:]))
        files = {}
        for line in result.stdout.splitlines():
            digest, _, path = line.partition('  ./')
            files[name(path)] = digest
        return files

    def logcat(self, uid, since=None, crash=False):
        args = ['logcat', '-d', '-v', 'time']
        args += ['-b', 'crash'] if crash else ['--uid', str(uid)]
        if since:
            args += ['-T', since]
        self.connect()
        text = self.run(*args, timeout=120)
        if crash:
            lines = text.splitlines()
            keep = set()
            for i, line in enumerate(lines):
                if PKG in line:
                    keep.update(range(max(0, i - 2), min(len(lines), i + 40)))
            text = '\n'.join(lines[i] for i in sorted(keep)[-400:])
        return self.redact(text)

    def device_time(self):
        return self.shell("date '+%m-%d %H:%M:%S.000'").strip()

    # --- host-side APK inspection ---------------------------------------
    def tool(self, binary):
        found = sorted((self.sdk / 'build-tools').glob('*/' + binary))
        if not found:
            raise Failed('Android build tool missing: ' + binary)
        return str(found[-1])

    def apk_info(self, path):
        path = Path(path)
        if path.is_symlink() or not path.is_file() or path.suffix != '.apk':
            raise Refused('need an ordinary .apk file')
        badging = subprocess.run([self.tool('aapt2'), 'dump', 'badging', str(path)],
                                 capture_output=True, text=True, check=True).stdout
        header = re.search(r"^package: name='([^']+)' versionCode='(\d*)'", badging, re.M)
        if not header or header.group(1) not in (PKG, TEST):
            raise Refused('APK is not the dictation app or its test package')
        pkg = header.group(1)
        perms = set(re.findall(r"^uses-permission(?:-sdk-23)?: name='([^']+)'", badging, re.M))
        if perms & NETWORK:
            raise Refused('APK requests network or package-query permission: ' + ', '.join(sorted(perms & NETWORK)))
        if perms - PERMISSIONS[pkg]:
            raise Refused('APK permissions outside allowlist: ' + ', '.join(sorted(perms - PERMISSIONS[pkg])))
        tree = subprocess.run([self.tool('aapt2'), 'dump', 'xmltree', str(path), '--file', 'AndroidManifest.xml'],
                              capture_output=True, text=True, check=True).stdout
        if re.search(r'^\s*E: queries', tree, re.M):
            raise Refused('APK declares <queries>; package enumeration is out of scope')
        target = re.findall(r'targetPackage[^=]*="([^"]+)"', tree)
        if pkg == TEST and target != [PKG]:
            raise Refused('test APK must instrument only ' + PKG)
        signing = subprocess.run([self.tool('apksigner'), 'verify', '--print-certs', str(path)],
                                 capture_output=True, text=True, check=True).stdout
        signers = set(re.findall(r'certificate SHA-256 digest: ([0-9a-f]{64})', signing))
        if len(signers) != 1:
            raise Refused('need exactly one APK signer')
        return {'package': pkg, 'versionCode': int(header.group(2) or 0), 'sha256': sha_file(path),
                'signer': signers.pop(), 'permissions': sorted(perms)}

    # --- mutations --------------------------------------------------------
    def install(self, path):
        self.connect()
        self.run('install', '-r', str(path), timeout=600)

    def uninstall(self, pkg):
        if pkg not in (PKG, TEST):
            raise Refused('package outside scope')
        self.connect()
        self.run('uninstall', pkg, timeout=120)

    def stop(self):
        self.shell('am force-stop ' + PKG)

    def push(self, directory, rel):
        """Replace files/<rel> with the regular files of a host directory."""
        directory = validate_directory(directory)
        tmp = '/data/local/tmp/dictation-' + uuid.uuid4().hex
        self.shell('mkdir ' + tmp)
        try:
            self.run('push', str(directory) + '/.', tmp, timeout=900)
            self.private('rm -rf -- %s && mkdir -p %s && cp -r %s/. %s/' % ((shlex.quote(rel),) * 2 + (tmp, shlex.quote(rel))),
                         timeout=600)
        finally:
            self.shell('rm -rf -- ' + tmp)

    def tar(self, *rels):
        existing = [r for r in rels if self.private('[ -d %s ] && echo y' % shlex.quote(r), check=False).strip() == 'y']
        if not existing:
            return b''
        self.connect()
        return self.run('exec-out', 'run-as', PKG, 'tar', 'c', *existing, timeout=900, binary=True)

    def pull_apk(self, remote, local):
        self.connect()
        if not re.fullmatch(r'/data/app/[A-Za-z0-9_./=~+-]+\.apk', remote):
            raise Refused('unexpected installed APK path')
        Path(local).write_bytes(self.run('exec-out', 'cat', remote, timeout=600, binary=True))

    def replace_data(self, archive):
        """Wipe app data dirs and extract a host-validated tar."""
        self.private('rm -rf -- ' + ' '.join(DATA_DIRS))
        if archive:
            self.connect()
            self.run('exec-out', 'run-as', PKG, 'tar', 'x', timeout=900, binary=True, stdin=archive)

    def instrument(self, classes, extras, timeout):
        args = ' '.join('-e %s %s' % (shlex.quote(k), shlex.quote(v)) for k, v in extras)
        return self.shell('am instrument -w -r -e class %s %s %s' % (shlex.quote(classes), args, RUNNER), timeout=timeout)


def validate_directory(directory):
    """Only regular files and directories with safe names may leave the host."""
    directory = Path(directory)
    if not directory.is_dir():
        raise Refused('push needs a directory')
    for p in [directory, *directory.rglob('*')]:
        if p.is_symlink() or not (p.is_dir() or p.is_file()):
            raise Refused('only regular files and directories can be pushed')
        if p != directory:
            name(p.relative_to(directory).as_posix())
    return directory


def validate_tar(payload):
    """Members must be regular files/dirs under the app data dirs; no .., links, devices."""
    if not payload:
        return
    with tarfile.open(fileobj=io.BytesIO(payload)) as archive:
        for member in archive:
            parts = Path(member.name).parts
            if not parts or parts[0] not in DATA_DIRS or '..' in parts or member.name.startswith('/'):
                raise Refused('archive member outside app data: ' + member.name[:80])
            if not (member.isfile() or member.isdir()):
                raise Refused('archive member is not a regular file: ' + member.name[:80])


class Phone:
    """The command layer. `state` is corpus/lab."""

    def __init__(self, device, state):
        self.device = device
        self.state = Path(state)

    # --- helpers ---------------------------------------------------------
    def app(self):
        return self.device.package(PKG)

    def identity(self):
        app, test = self.device.package(PKG), self.device.package(TEST)
        lab = self.device.inventory('files/lab') if app['installed'] else None
        return {'app_sha256': app.get('sha256'), 'test_sha256': test.get('sha256'),
                'lab_sha256': sha(json.dumps(lab, sort_keys=True).encode()) if lab is not None else None}

    def meta(self, verb, **extra):
        folder = self.state / 'runs' / (time.strftime('%Y%m%dT%H%M%S') + '-' + verb + '-' + uuid.uuid4().hex[:6])
        folder.mkdir(parents=True, exist_ok=False)
        record = dict(verb=verb, ts=time.strftime('%Y-%m-%dT%H:%M:%S'), **self.identity(), **extra)
        (folder / 'meta.json').write_text(json.dumps(record, indent=1, sort_keys=True))
        return folder

    def not_live(self, verb):
        ime = self.device.ime()
        if ime['bound'] or ime['input_shown']:
            raise Refused(verb + ' refused: the dictation keyboard is in use right now')

    def lock(self):
        import fcntl
        self.state.mkdir(parents=True, exist_ok=True)
        handle = (self.state / '.phone.lock').open('a')
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Refused('another phone command is running') from None
        return handle

    # --- verbs -----------------------------------------------------------
    def status(self):
        try:
            self.device.connect()
        except Failed as error:
            return {'connected': False, 'reason': str(error)}
        return {'connected': True, 'model': MODEL}

    def device_info(self):
        return {'props': self.device.props(), 'thermal_status': self.device.thermal(),
                'driver_libs': self.device.driver_libs()}

    def app_info(self):
        info = {'app': self.app(), 'test': self.device.package(TEST), 'ime': self.device.ime(),
                'futo': {p: self.device.package(p) for p in FUTO}}
        info['app'].pop('apk_path', None)
        info['lab'] = self.device.inventory('files/lab') if info['app']['installed'] else None
        return info

    def install(self, app_apk, test_apk=None):
        infos = [self.device.apk_info(app_apk)] + ([self.device.apk_info(test_apk)] if test_apk else [])
        if infos[0]['package'] != PKG or (test_apk and infos[1]['package'] != TEST):
            raise Refused('arguments are APP.apk then TEST.apk')
        if len({i['signer'] for i in infos}) != 1:
            raise Refused('app and test APK must share one signer')
        # Signer continuity against the installed app is enforced by Android itself.
        self.not_live('install')
        folder = self.meta('install', apks=[i['sha256'] for i in infos])
        self.device.install(app_apk)
        if test_apk:
            self.device.install(test_apk)
        after = self.identity()
        if after['app_sha256'] != infos[0]['sha256'] or (test_apk and after['test_sha256'] != infos[1]['sha256']):
            raise Failed('installed identity does not match the given APKs')
        return {'outcome': 'installed', **after, 'meta': str(folder / 'meta.json')}

    def push(self, directory, rel='lab'):
        rel = name(rel)
        directory = validate_directory(directory)
        self.device.push(directory, 'files/' + rel)
        expected = {p.relative_to(directory).as_posix(): sha_file(p) for p in Path(directory).rglob('*') if p.is_file()}
        actual = self.device.inventory('files/' + rel)
        if actual != expected:
            raise Failed('pushed inventory differs from the host directory')
        folder = self.meta('push', target='files/' + rel, files=len(expected))
        return {'outcome': 'pushed', 'target': 'files/' + rel, 'files': len(expected), 'meta': str(folder / 'meta.json')}

    def pull(self, paths, to=None):
        rels = [name(p, PULL_ROOTS) for p in paths]
        payload = self.device.tar(*rels)
        validate_tar(payload)
        dest = Path(to) if to else self.state / 'pull' / time.strftime('%Y%m%dT%H%M%S')
        dest.mkdir(parents=True, exist_ok=False)
        count = 0
        if payload:
            with tarfile.open(fileobj=io.BytesIO(payload)) as archive:
                for member in archive:
                    if member.isfile():
                        target = dest / member.name
                        target.parent.mkdir(parents=True, exist_ok=True)
                        with archive.extractfile(member) as src, target.open('xb') as out:
                            shutil.copyfileobj(src, out)
                        count += 1
        return {'outcome': 'pulled', 'files': count, 'path': str(dest)}

    def run(self, classes, extras, timeout=1800):
        if not re.fullmatch(r'[A-Za-z0-9_.]+(?:#[A-Za-z0-9_]+)?(?:,[A-Za-z0-9_.]+(?:#[A-Za-z0-9_]+)?)*', classes):
            raise Refused('unsupported test class list')
        pairs = []
        for item in extras:
            key, eq, value = item.partition('=')
            if not eq or not re.fullmatch(r'[A-Za-z][A-Za-z0-9_]*', key) or len(value) > 256:
                raise Refused('extras are key=value with a short value')
            pairs.append((key, value))
        if not self.device.package(TEST)['installed']:
            raise Refused('test package is not installed; use install APP.apk TEST.apk')
        folder = self.meta('run', classes=classes, extras=pairs)
        since = self.device.device_time()
        uid = self.app()['uid']
        output = self.device.instrument(classes, pairs, timeout)
        (folder / 'instrumentation.txt').write_text(output)
        (folder / 'logcat.txt').write_text(self.device.logcat(uid, since=since))
        ok = bool(re.search(r'^OK \(\d+ tests?\)', output, re.M)) and 'INSTRUMENTATION_CODE: -1' in output
        return {'outcome': 'passed' if ok else 'failed', 'path': str(folder),
                'lab': self.device.inventory('files/lab')}

    def logs(self, since=None):
        app = self.app()
        if not app['installed']:
            raise Refused('app not installed')
        return {'logs': self.device.logcat(app['uid'], since=since)}

    def crash(self):
        return {'crash': self.device.logcat(None, crash=True)}

    def stop(self):
        self.not_live('stop')
        self.device.stop()
        return {'outcome': 'stopped'}

    def snapshot(self, label):
        label = name(label)
        folder = self.state / 'snapshots' / label
        if folder.exists():
            raise Refused('snapshot exists: ' + label)
        app, test = self.device.package(PKG), self.device.package(TEST)
        if not app['installed']:
            raise Refused('nothing to snapshot; app not installed')
        folder.mkdir(parents=True)
        self.device.pull_apk(app['apk_path'], folder / 'app.apk')
        if test['installed']:
            self.device.pull_apk(test['apk_path'], folder / 'test.apk')
        payload = self.device.tar(*DATA_DIRS)
        validate_tar(payload)
        (folder / 'data.tar').write_bytes(payload)
        record = {'app_sha256': app['sha256'], 'test_sha256': test.get('sha256'), 'granted': app['granted'],
                  'ime': self.device.ime(), 'data_sha256': sha(payload), 'ts': time.strftime('%Y-%m-%dT%H:%M:%S')}
        for key, local in (('app_sha256', 'app.apk'), ('test_sha256', 'test.apk')):
            if record[key] and sha_file(folder / local) != record[key]:
                raise Failed('pulled APK differs from the installed one')
        (folder / 'snapshot.json').write_text(json.dumps(record, indent=1, sort_keys=True))
        return {'outcome': 'snapshotted', 'path': str(folder), **record}

    def restore(self, label):
        folder = self.state / 'snapshots' / name(label)
        record = json.loads((folder / 'snapshot.json').read_text())
        payload = (folder / 'data.tar').read_bytes()
        if sha(payload) != record['data_sha256']:
            raise Refused('snapshot archive changed since it was taken')
        validate_tar(payload)
        for key, local in (('app_sha256', 'app.apk'), ('test_sha256', 'test.apk')):
            if record.get(key) and sha_file(folder / local) != record[key]:
                raise Refused('snapshot APK changed since it was taken')
        self.not_live('restore')
        meta = self.meta('restore', snapshot=label)
        current = self.identity()
        if current['app_sha256'] != record['app_sha256']:
            self.device.install(folder / 'app.apk')
        if record.get('test_sha256') and current['test_sha256'] != record['test_sha256']:
            self.device.install(folder / 'test.apk')
        self.device.replace_data(payload)
        after = self.identity()
        app = self.app()
        if after['app_sha256'] != record['app_sha256'] or (
                record.get('test_sha256') and after['test_sha256'] != record['test_sha256']):
            raise Failed('restored APK identity does not match the snapshot')
        not_restored = {'granted_permissions_missing': sorted(set(record['granted']) - set(app['granted'])),
                        'ime_state_then': record['ime'], 'ime_state_now': self.device.ime(),
                        'note': 'microphone grant, IME enablement/selection and FUTO toggles are not restorable here'}
        return {'outcome': 'restored', **after, 'not_restored': not_restored, 'meta': str(meta / 'meta.json')}

    def uninstall(self):
        token = self.state / '.allow-uninstall'
        if not token.is_file():
            raise Refused('uninstall needs the user to create ' + str(token))
        if self.device.ime()['enabled']:
            raise Refused('uninstall refused while the dictation keyboard is enabled; disable it first')
        self.not_live('uninstall')
        self.meta('uninstall')
        token.unlink()
        for pkg in (TEST, PKG):
            if self.device.package(pkg)['installed']:
                self.device.uninstall(pkg)
        return {'outcome': 'uninstalled'}


USAGE = """App-scoped phone access for ch.og.dictation. Output is one JSON object.
  status                          phone connected and permitted
  device                          allowlisted hardware/OS props, thermal status, GPU/TPU driver libs
  app                             our app, test package, our IME state, FUTO versions, files/lab inventory
  install APP.apk [TEST.apk]      only our packages; permission allowlist; no network permissions
  push DIR [NAME]                 replace files/NAME (default lab) with DIR's regular files
  pull PATH... [--to DIR]         from files/lab or files/benchmark into corpus/lab/pull/<ts>/
  run CLASS[#method][,...] [k=v]  am instrument on the test package; saves output + app logcat
  logs [--since 'MM-DD HH:MM:SS.mmm'] | crash
  stop                            force-stop our app
  snapshot NAME | restore NAME    retained APKs + files/, shared_prefs/, databases/; reports what it cannot restore
  uninstall                       needs corpus/lab/.allow-uninstall created by the user
Exit 0 ok · 3 refused (policy) · 1 failed (device; retry allowed).
install, restore, stop, uninstall refuse while the keyboard is in use."""


def dispatch(argv, phone):
    verb, args = (argv[0] if argv else 'help'), argv[1:]
    if verb in ('help', '-h', '--help'):
        return {'usage': USAGE}
    simple = {'status': phone.status, 'device': phone.device_info, 'app': phone.app_info,
              'crash': phone.crash, 'stop': phone.stop, 'uninstall': phone.uninstall}
    if verb in simple:
        if args:
            raise Refused(verb + ' takes no arguments')
        return simple[verb]()
    if verb == 'install' and 1 <= len(args) <= 2:
        return phone.install(*args)
    if verb == 'push' and 1 <= len(args) <= 2:
        return phone.push(*args)
    if verb == 'pull' and args:
        to = None
        if '--to' in args:
            i = args.index('--to')
            to, args = args[i + 1] if i + 1 < len(args) else None, args[:i] + args[i + 2:]
            if to is None:
                raise Refused('--to needs a directory')
        return phone.pull(args, to)
    if verb == 'run' and args:
        return phone.run(args[0], args[1:])
    if verb == 'logs' and len(args) in (0, 2):
        return phone.logs(args[1] if args else None)
    if verb in ('snapshot', 'restore') and len(args) == 1:
        return getattr(phone, verb)(args[0])
    raise Refused('unknown command or arguments; see help')


def main(argv):
    root = subprocess.run(['git', 'rev-parse', '--show-toplevel'], capture_output=True, text=True)
    if root.returncode:
        raise Failed('run from inside the checkout')
    state = Path(root.stdout.strip()) / 'corpus' / 'lab'
    os.umask(0o077)
    phone = Phone(Device(os.environ.get('ANDROID_HOME', Path.home() / 'Android/Sdk')), state)
    verb = argv[0] if argv else 'help'
    handle = phone.lock() if verb not in ('help', '-h', '--help', 'status') else None
    try:
        result = dispatch(argv, phone)
    finally:
        if handle:
            handle.close()
    print(result['usage'] if set(result) == {'usage'} else json.dumps(result, indent=1, sort_keys=True))
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as error:
        print('refused: ' + str(error), file=sys.stderr)
        sys.exit(3)
    except (Failed, OSError, subprocess.SubprocessError, tarfile.TarError, zipfile.BadZipFile, ValueError, KeyError) as error:
        print('failed: ' + str(error), file=sys.stderr)
        sys.exit(1)
